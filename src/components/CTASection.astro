---
interface Props { title: string; primaryHref: string; primaryLabel: string; secondaryHref?: string; secondaryLabel?: string; eyebrow?: string; }
const { title, primaryHref, primaryLabel, secondaryHref, secondaryLabel, eyebrow = 'Keep exploring Orbis' } = Astro.props;
---
<section class="cta-section"><div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2></div><div class="cta-actions"><a class="button primary" href={primaryHref}>{primaryLabel}</a>{secondaryHref && secondaryLabel && <a class="button secondary" href={secondaryHref}>{secondaryLabel}</a>}</div></section>
<style>
  .cta-section { display: flex; justify-content: space-between; gap: 2rem; align-items: end; padding: 2rem; background: var(--accent-soft); border: 1px solid hsl(199 86% 58% / 0.35); border-radius: 16px; }
  .eyebrow { color: var(--accent-light); text-transform: uppercase; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; margin: 0 0 0.45rem; }
  h2 { max-width: 18ch; margin: 0; line-height: 1.1; letter-spacing: -0.035em; }
  .cta-actions { display: flex; gap: 0.7rem; flex-wrap: wrap; }
  .button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; border-radius: 8px; padding: 0.7rem 1rem; font-size: 0.82rem; font-weight: 800; text-decoration: none; }
  .primary { color: var(--wash); background: var(--accent); }
  .secondary { color: var(--ink); border: 1px solid var(--line); background: var(--paper); }
  @media (max-width: 700px) { .cta-section { display: grid; } }
</style>
