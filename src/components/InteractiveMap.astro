---
import { MAP_BASE_LAYER, MAP_TRANSFORM_CONFIG, transformMapCoordinate } from '../lib/map-coordinate-transform.js';

interface Marker {
  id: string;
  name: string;
  category: 'EONAS_LEGACY' | 'ORGANA_STATUE' | 'WARP_POINT' | 'DUNGEON' | 'BOSS' | 'CHEST';
  subtype?: string;
  region: string;
  x: number;
  y: number;
  precision: string;
  verification_status: string;
  confidence: string;
  source_summary: string;
  game_version: string;
  last_checked: string;
  description: string;
  aliases?: string[];
  navigation_note?: string;
  activity_note?: string;
  location_note?: string;
}

interface MarkerData {
  base_map_id: string;
  coordinate_system: string;
  data_policy: string;
  source_boundary: string;
  game_version: string;
  last_checked: string;
  category_status?: {
    ORGANA_STATUE?: {
      count_conflict?: string;
      conflict_verdict?: string;
    };
  };
  markers: Marker[];
}

const { markerData } = Astro.props as { markerData: MarkerData };
const { chestMarkerCount = 0 } = Astro.props as { chestMarkerCount?: number };
const { labels: suppliedLabels = {}, locale = 'en' } = Astro.props as { labels?: Record<string, any>; locale?: 'en' | 'ja' };
const defaultLabels = {
  headings: {
    eyebrow: 'Interactive beta · Independent Orbis atlas',
    title: 'DragonSword Awakening Interactive Map Beta',
    description: 'Search, filter, pan and zoom approximate Orbis markers while exact routes are still being verified.',
    betaMarkers: 'beta markers',
    chests: 'chests',
    firstHandVerified: 'first-hand verified',
    found: 'found',
    markerSummary: 'Map marker summary',
    viewportLabel: 'Independent Orbis atlas. Drag to pan and use controls to zoom.',
    schematicTitle: 'Independent Orbis atlas',
    schematicDescription: 'A DragonSwordGuide-owned illustrated Orbis atlas for approximate DragonSword Awakening beta markers. Not an official in-game map.',
    schematicLabel: 'Independent Orbis map',
    scaleNote: 'Approximate layout, not exact in-game coordinates',
  },
  categories: {
    EONAS_LEGACY: "Eona's Legacy",
    ORGANA_STATUE: 'Organa Statues',
    WARP_POINT: 'Warp Points',
    DUNGEON: 'Dungeons',
    BOSS: 'Bosses',
    CHEST: 'Treasure Chests',
  },
  statuses: {
    OFFICIAL_VERIFIED: 'Official verified',
    FIRST_HAND_VERIFIED: 'First-hand verified',
    VIDEO_VERIFIED: 'Video verified',
    SECONDARY_CORROBORATED: 'Source corroborated',
    APPROXIMATE: 'Approximate',
    CONFLICTING: 'Conflicting',
  },
  precision: {
    LANDMARK_APPROXIMATE: 'Approximate location',
    REGION_APPROXIMATE: 'Approximate region',
    APPROXIMATE: 'Approximate location',
  },
  confidence: {
    HIGH: 'High',
    MEDIUM: 'Medium',
    LOW: 'Low',
  },
  controls: {
    toolbar: 'Interactive map controls',
    searchLabel: 'Search markers',
    searchPlaceholder: 'Search name or region',
    filters: 'Marker categories',
    chestRegion: 'Chest region',
    allLoadedRegions: 'All loaded regions',
    zoomControls: 'Map view controls',
    zoomIn: 'Zoom in',
    zoomOut: 'Zoom out',
    reset: 'Reset',
    progressControls: 'Map progress controls',
    hideCompleted: 'Hide found',
    resetCompleted: 'Reset found markers',
    noMatches: 'No matching locations',
  },
  panel: {
    region: 'Region',
    subtype: 'Subtype',
    bossType: 'Boss type',
    precision: 'Precision',
    status: 'Status',
    confidence: 'Confidence',
    markFound: 'Mark as found',
    markNotFound: 'Mark as not found',
    foundStatus: 'Saved on this device',
    notFoundStatus: 'Not marked found',
  },
  chest: {
    displayPrefix: 'Treasure Chest',
    clusterLabel: 'Treasure Chests',
    subtypeLabels: {},
  },
  regions: {},
};
const mapLabels = {
  ...defaultLabels,
  ...suppliedLabels,
  headings: { ...defaultLabels.headings, ...(suppliedLabels.headings || {}) },
  categories: { ...defaultLabels.categories, ...(suppliedLabels.categories || {}) },
  statuses: { ...defaultLabels.statuses, ...(suppliedLabels.statuses || {}) },
  precision: { ...defaultLabels.precision, ...(suppliedLabels.precision || {}) },
  confidence: { ...defaultLabels.confidence, ...(suppliedLabels.confidence || {}) },
  controls: { ...defaultLabels.controls, ...(suppliedLabels.controls || {}) },
  panel: { ...defaultLabels.panel, ...(suppliedLabels.panel || {}) },
  chest: { ...defaultLabels.chest, ...(suppliedLabels.chest || {}) },
  regions: { ...defaultLabels.regions, ...(suppliedLabels.regions || {}) },
};
const categoryLabels = mapLabels.categories;
const statusLabels = mapLabels.statuses;
const precisionLabels = mapLabels.precision || {};
const confidenceLabels = mapLabels.confidence || {};
const regionLabel = (region: string) => mapLabels.regions[region] || region;
const humanizeEnum = (value: string) => String(value || '').toLowerCase().replaceAll('_', ' ').replace(/\b\w/g, (char) => char.toUpperCase());
const precisionLabel = (value: string) => precisionLabels[value] || humanizeEnum(value);
const confidenceLabel = (value: string) => confidenceLabels[value] || humanizeEnum(value);
const categoryCounts = markerData.markers.reduce<Record<string, number>>((counts, marker) => {
  counts[marker.category] = (counts[marker.category] || 0) + 1;
  return counts;
}, {});
categoryCounts.CHEST = chestMarkerCount;
const firstMarker = markerData.markers[0];
---

<section
  class="interactive-map"
  data-map-mvp
  data-base-map-id={markerData.base_map_id}
  data-coordinate-system={markerData.coordinate_system}
  data-organa-count-conflict={markerData.category_status?.ORGANA_STATUE?.count_conflict}
  data-organa-conflict-verdict={markerData.category_status?.ORGANA_STATUE?.conflict_verdict}
  data-marker-count={markerData.markers.length + chestMarkerCount}
  data-chest-marker-count={chestMarkerCount}
  data-chest-manifest-url="/data/map/chests/manifest.json"
  data-locale={locale}
  aria-labelledby="interactive-map-title"
>
  <div class="map-heading">
    <div>
      <p class="eyebrow">{mapLabels.headings.eyebrow}</p>
      <h2 id="interactive-map-title">{mapLabels.headings.title}</h2>
      <p>{mapLabels.headings.description}</p>
    </div>
    <div class="map-stats" aria-label={mapLabels.headings.markerSummary}>
      <span><strong>{markerData.markers.length + chestMarkerCount}</strong> {mapLabels.headings.betaMarkers}</span>
      <span><strong>{chestMarkerCount}</strong> {mapLabels.headings.chests}</span>
      <span><strong>0</strong> {mapLabels.headings.firstHandVerified}</span>
      <span class="map-progress-stat"><strong data-map-progress-percentage>0%</strong><small><b data-map-progress-count>0</b> / {markerData.markers.length + chestMarkerCount} {mapLabels.headings.found}</small></span>
    </div>
  </div>

  <div class="map-toolbar" aria-label={mapLabels.controls.toolbar}>
    <label class="search-field">
      <span>{mapLabels.controls.searchLabel}</span>
      <input data-marker-search type="search" placeholder={mapLabels.controls.searchPlaceholder} autocomplete="off" />
    </label>
    <div class="filter-group" aria-label={mapLabels.controls.filters}>
      {Object.entries(categoryLabels).map(([category, label]) => (
        <label class="filter-pill">
          <input data-category-filter type="checkbox" value={category} checked={category !== 'CHEST'} />
          <span>{label} <small>{categoryCounts[category] || 0}</small></span>
        </label>
      ))}
    </div>
    <label class="chest-region-field">
      <span>{mapLabels.controls.chestRegion}</span>
      <select data-chest-region-filter disabled>
        <option value="">{mapLabels.controls.allLoadedRegions}</option>
      </select>
    </label>
    <div class="zoom-actions" aria-label={mapLabels.controls.zoomControls}>
      <button type="button" data-map-action="zoom-out" aria-label={mapLabels.controls.zoomOut}>-</button>
      <button type="button" data-map-action="reset">{mapLabels.controls.reset}</button>
      <button type="button" data-map-action="zoom-in" aria-label={mapLabels.controls.zoomIn}>+</button>
    </div>
    <div class="progress-actions" aria-label={mapLabels.controls.progressControls}>
      <label class="progress-toggle">
        <input data-hide-completed type="checkbox" />
        <span>{mapLabels.controls.hideCompleted}</span>
      </label>
      <button type="button" data-map-action="reset-completed">{mapLabels.controls.resetCompleted}</button>
    </div>
  </div>

  <div class="map-workspace">
    <div class="map-frame">
      <div class="map-viewport" data-map-viewport aria-label={mapLabels.headings.viewportLabel}>
        <div class="map-canvas" data-map-canvas>
          <picture>
            <source srcset={MAP_BASE_LAYER.src} type="image/webp" />
            <img class="orbis-atlas-map" src={MAP_BASE_LAYER.fallback_src} alt={mapLabels.headings.schematicDescription} width={MAP_BASE_LAYER.width} height={MAP_BASE_LAYER.height} loading="eager" />
          </picture>
          {markerData.markers.map((marker) => {
            const point = transformMapCoordinate(marker.x, marker.y, marker.region);
            return (
              <button
                type="button"
                class={`marker marker-${marker.category.toLowerCase().replaceAll('_', '-')}`}
                data-marker-id={marker.id}
                data-marker-category={marker.category}
                data-marker-status={marker.verification_status}
                data-marker-name={marker.name}
                data-marker-region={regionLabel(marker.region)}
                data-marker-subtype={marker.subtype || ''}
                data-marker-aliases={[...(marker.aliases || []), categoryLabels[marker.category], marker.region, regionLabel(marker.region)].join(' ')}
                data-render-x={point.x}
                data-render-y={point.y}
                style={`left:${point.x * 100}%;top:${point.y * 100}%;`}
                aria-label={`${marker.name}, ${regionLabel(marker.region)}, ${precisionLabel(marker.precision).toLowerCase()}`}
              >
                <span aria-hidden="true"></span>
              </button>
            );
          })}
          <div class="chest-layer" data-chest-layer aria-live="polite"></div>
        </div>
      </div>
      <div class="map-scale-note" aria-label={mapLabels.headings.scaleNote}>
        <span>{mapLabels.headings.schematicLabel}</span>
        <span>{mapLabels.headings.scaleNote}</span>
      </div>
    </div>

    <aside class="marker-panel" data-marker-panel aria-live="polite">
      <p class="panel-kicker">{categoryLabels[firstMarker.category]}</p>
      <h3>{firstMarker.name}</h3>
      <span class={`status-badge status-${firstMarker.verification_status.toLowerCase().replaceAll('_', '-')}`}>{statusLabels[firstMarker.verification_status]}</span>
      <dl>
        <div><dt>{mapLabels.panel.region}</dt><dd>{regionLabel(firstMarker.region)}</dd></div>
        {firstMarker.subtype && <div><dt>{firstMarker.category === 'BOSS' ? mapLabels.panel.bossType : mapLabels.panel.subtype}</dt><dd>{firstMarker.subtype}</dd></div>}
        <div><dt>{mapLabels.panel.precision}</dt><dd>{precisionLabel(firstMarker.precision)}</dd></div>
        <div><dt>{mapLabels.panel.status}</dt><dd>{statusLabels[firstMarker.verification_status] || humanizeEnum(firstMarker.verification_status)}</dd></div>
        <div><dt>{mapLabels.panel.confidence}</dt><dd>{confidenceLabel(firstMarker.confidence)}</dd></div>
      </dl>
      <p>{firstMarker.description}</p>
      {firstMarker.activity_note && <p class="activity-note">{firstMarker.activity_note}</p>}
      {firstMarker.location_note && <p class="location-note">{firstMarker.location_note}</p>}
      <p class="source-note">{firstMarker.source_summary}</p>
      {firstMarker.navigation_note && <p class="navigation-note">{firstMarker.navigation_note}</p>}
      <div class="marker-progress-actions">
        <button type="button" data-map-action="toggle-completed" aria-pressed="false">{mapLabels.panel.markFound}</button>
        <small data-map-progress-status>{mapLabels.panel.notFoundStatus}</small>
      </div>
    </aside>
  </div>

  <p class="map-boundary">{markerData.source_boundary}</p>
  <script type="application/json" id="map-marker-data" set:html={JSON.stringify(markerData.markers)} />
  <script type="application/json" id="map-label-data" set:html={JSON.stringify(mapLabels)} />
  <script type="application/json" id="map-transform-data" set:html={JSON.stringify(MAP_TRANSFORM_CONFIG)} />
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-map-mvp]');
      if (!root) return;

      const markerDataScript = root.querySelector('#map-marker-data');
      const labelDataScript = root.querySelector('#map-label-data');
      const transformDataScript = root.querySelector('#map-transform-data');
      const baseMarkers = JSON.parse(markerDataScript.textContent || '[]');
      const mapLabels = JSON.parse(labelDataScript.textContent || '{}');
      const transformConfig = JSON.parse(transformDataScript.textContent || '{}');
      const canvas = root.querySelector('[data-map-canvas]');
      const viewport = root.querySelector('[data-map-viewport]');
      const panel = root.querySelector('[data-marker-panel]');
      const search = root.querySelector('[data-marker-search]');
      const filters = Array.from(root.querySelectorAll('[data-category-filter]'));
      const hideCompleted = root.querySelector('[data-hide-completed]');
      const progressCount = root.querySelector('[data-map-progress-count]');
      const progressPercentage = root.querySelector('[data-map-progress-percentage]');
      const chestRegionFilter = root.querySelector('[data-chest-region-filter]');
      const chestLayer = root.querySelector('[data-chest-layer]');
      const chestManifestUrl = root.dataset.chestManifestUrl;
      const labels = mapLabels.categories || {};
      const statusLabels = mapLabels.statuses || {};
      const precisionLabels = mapLabels.precision || {};
      const confidenceLabels = mapLabels.confidence || {};
      const panelLabels = mapLabels.panel || {};
      const chestLabels = mapLabels.chest || {};
      const regionLabels = mapLabels.regions || {};
      const chestMarkers = [];
      const progressStorageKey = 'dragonswordguide.map.completed.v1';
      const totalMarkerCount = Number(root.dataset.markerCount || 0);
      let chestLoadPromise = null;
      const maxIndividualChestMarkers = 420;
      let selectedMarkerId = baseMarkers[0]?.id || '';
      let scale = 1;
      let offsetX = 0;
      let offsetY = 0;
      let dragStart = null;

      function trackToolEvent(name, parameters = {}) {
        if (typeof window.gtag !== 'function') return;
        window.gtag('event', name, {
          tool_name: 'interactive_map',
          page_path: window.location.pathname,
          ...parameters,
        });
      }

      function readCompletedMarkerIds() {
        try {
          const parsed = JSON.parse(window.localStorage.getItem(progressStorageKey) || '[]');
          if (!Array.isArray(parsed)) return new Set();
          return new Set(parsed.filter((id) => typeof id === 'string' && id.trim()));
        } catch {
          return new Set();
        }
      }

      const completedMarkerIds = readCompletedMarkerIds();

      function persistCompletedMarkerIds() {
        try {
          if (completedMarkerIds.size === 0) {
            window.localStorage.removeItem(progressStorageKey);
            return;
          }
          window.localStorage.setItem(progressStorageKey, JSON.stringify(Array.from(completedMarkerIds).sort()));
        } catch {
          // Progress remains usable in memory when storage is unavailable.
        }
      }

      function updateMarkerQuery(id) {
        const url = new URL(window.location.href);
        url.searchParams.set('marker', id);
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      }

      function updateCompletionSummary() {
        const completedCount = Math.min(completedMarkerIds.size, totalMarkerCount);
        const percentage = totalMarkerCount > 0 ? Math.round((completedCount / totalMarkerCount) * 100) : 0;
        root.dataset.completedMarkerCount = String(completedCount);
        if (progressCount) progressCount.textContent = String(completedCount);
        if (progressPercentage) progressPercentage.textContent = `${percentage}%`;
      }

      function syncCompletionUi() {
        markerButtons().forEach((button) => {
          button.toggleAttribute('data-marker-completed', completedMarkerIds.has(button.dataset.markerId));
        });
        const toggle = panel?.querySelector('[data-map-action="toggle-completed"]');
        const status = panel?.querySelector('[data-map-progress-status]');
        const completed = completedMarkerIds.has(selectedMarkerId);
        if (toggle) {
          toggle.textContent = completed ? panelLabels.markNotFound || 'Mark as not found' : panelLabels.markFound || 'Mark as found';
          toggle.setAttribute('aria-pressed', String(completed));
        }
        if (status) status.textContent = completed ? panelLabels.foundStatus || 'Saved on this device' : panelLabels.notFoundStatus || 'Not marked found';
        updateCompletionSummary();
      }

      function setTransform() {
        canvas.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
        renderChestLayer();
      }

      function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        }[char]));
      }

      function localizedRegion(region) {
        return regionLabels[region] || region;
      }

      function humanizeEnum(value) {
        return String(value || '').toLowerCase().replaceAll('_', ' ').replace(/\b\w/g, (char) => char.toUpperCase());
      }

      function precisionLabel(value) {
        return precisionLabels[value] || humanizeEnum(value);
      }

      function confidenceLabel(value) {
        return confidenceLabels[value] || humanizeEnum(value);
      }

      function clamp01(value) {
        return Math.min(1, Math.max(0, Number(value) || 0));
      }

      function transformCoordinate(x, y, regionId = '') {
        const sourceX = clamp01(x);
        const sourceY = clamp01(y);
        const anchors = transformConfig.anchors || [];
        let totalWeight = 0;
        let dx = 0;
        let dy = 0;

        anchors.forEach((anchor) => {
          const distance = Math.hypot(sourceX - anchor.old_x, sourceY - anchor.old_y);
          if (distance <= (transformConfig.exact_anchor_radius || 0)) {
            totalWeight = Number.POSITIVE_INFINITY;
            dx = anchor.new_x - sourceX;
            dy = anchor.new_y - sourceY;
            return;
          }
          if (!Number.isFinite(totalWeight)) return;
          const regionBoost = regionId && anchor.region === regionId ? (transformConfig.same_region_boost || 1) : 1;
          const weight = regionBoost / Math.pow(distance + 0.025, transformConfig.power || 2.2);
          totalWeight += weight;
          dx += (anchor.new_x - anchor.old_x) * weight;
          dy += (anchor.new_y - anchor.old_y) * weight;
        });

        if (!anchors.length || !totalWeight) return { x: sourceX, y: sourceY };
        if (!Number.isFinite(totalWeight)) return { x: clamp01(sourceX + dx), y: clamp01(sourceY + dy) };
        return { x: clamp01(sourceX + dx / totalWeight), y: clamp01(sourceY + dy / totalWeight) };
      }

      function markerRenderPoint(marker) {
        if (Number.isFinite(marker.render_x) && Number.isFinite(marker.render_y)) return { x: marker.render_x, y: marker.render_y };
        return transformCoordinate(marker.x, marker.y, marker.region || marker.chunk_key || '');
      }

      function localizedChestName(marker, index = 0) {
        const raw = String(marker.id || index + 1);
        const numeric = raw.match(/\d+/g)?.join('').slice(-4) || String(index + 1);
        return `${chestLabels.displayPrefix || 'Treasure Chest'} #${numeric} — ${localizedRegion(marker.region || marker.chunk_key || '')}`;
      }

      function localizedMarker(marker) {
        if (marker.category !== 'CHEST') {
          return {
            ...marker,
            display_name: marker.name,
            display_region: localizedRegion(marker.region),
            search_aliases: [
              marker.name,
              marker.region,
              localizedRegion(marker.region),
              labels[marker.category],
              marker.subtype,
              ...(marker.aliases || []),
            ],
          };
        }
        const displayName = marker.display_name || localizedChestName(marker);
        const subtypeLabel = chestLabels.subtypeLabels?.[marker.subtype] || marker.subtype || '';
        return {
          ...marker,
          display_name: displayName,
          display_region: localizedRegion(marker.region),
          search_aliases: [
            displayName,
            marker.name,
            marker.region,
            localizedRegion(marker.region),
            marker.subtype,
            subtypeLabel,
            labels.CHEST,
            ...(marker.aliases || []),
          ],
        };
      }

      function markerButtons() {
        return Array.from(root.querySelectorAll('[data-marker-id]'));
      }

      function allMarkers() {
        return baseMarkers.concat(chestMarkers);
      }

      function renderPanel(marker) {
        const localized = localizedMarker(marker);
        const navigationNote = marker.navigation_note ? `<p class="navigation-note">${escapeHtml(marker.navigation_note)}</p>` : '';
        const subtypeLabel = marker.category === 'BOSS' ? panelLabels.bossType || 'Boss type' : panelLabels.subtype || 'Subtype';
        const subtypeRow = marker.subtype ? `<div><dt>${escapeHtml(subtypeLabel)}</dt><dd>${escapeHtml(marker.subtype)}</dd></div>` : '';
        const activityNote = marker.activity_note ? `<p class="activity-note">${escapeHtml(marker.activity_note)}</p>` : '';
        const locationNote = marker.location_note ? `<p class="location-note">${escapeHtml(marker.location_note)}</p>` : '';
        const completed = completedMarkerIds.has(marker.id);
        panel.innerHTML = `
          <p class="panel-kicker">${escapeHtml(labels[marker.category] || marker.category)}</p>
          <h3>${escapeHtml(localized.display_name || marker.name)}</h3>
          <span class="status-badge status-${marker.verification_status.toLowerCase().replaceAll('_', '-')}">${escapeHtml(statusLabels[marker.verification_status] || marker.verification_status)}</span>
          <dl>
            <div><dt>${escapeHtml(panelLabels.region || 'Region')}</dt><dd>${escapeHtml(localized.display_region || marker.region)}</dd></div>
            ${subtypeRow}
            <div><dt>${escapeHtml(panelLabels.precision || 'Precision')}</dt><dd>${escapeHtml(precisionLabel(marker.precision))}</dd></div>
            <div><dt>${escapeHtml(panelLabels.status || 'Status')}</dt><dd>${escapeHtml(statusLabels[marker.verification_status] || humanizeEnum(marker.verification_status))}</dd></div>
            <div><dt>${escapeHtml(panelLabels.confidence || 'Confidence')}</dt><dd>${escapeHtml(confidenceLabel(marker.confidence))}</dd></div>
          </dl>
          <p>${escapeHtml(marker.description)}</p>
          ${activityNote}
          ${locationNote}
          <p class="source-note">${escapeHtml(marker.source_summary)}</p>
          ${navigationNote}
          <div class="marker-progress-actions">
            <button type="button" data-map-action="toggle-completed" aria-pressed="${completed}">${escapeHtml(completed ? panelLabels.markNotFound || 'Mark as not found' : panelLabels.markFound || 'Mark as found')}</button>
            <small data-map-progress-status>${escapeHtml(completed ? panelLabels.foundStatus || 'Saved on this device' : panelLabels.notFoundStatus || 'Not marked found')}</small>
          </div>
        `;
        panel.scrollTop = 0;
      }

      function selectMarker(id, options = {}) {
        const marker = allMarkers().find((item) => item.id === id);
        if (!marker) return;
        selectedMarkerId = id;
        markerButtons().forEach((button) => button.toggleAttribute('data-active-marker', button.dataset.markerId === id));
        renderPanel(marker);
        syncCompletionUi();
        keepSelectedMarkerClear(marker);
        if (options.updateUrl !== false) updateMarkerQuery(id);
        if (options.track !== false) {
          trackToolEvent('tool_result_generated', {
            marker_id: id,
            marker_category: marker.category,
          });
        }
      }

      function keepSelectedMarkerClear(marker) {
        if (!viewport || !panel || window.matchMedia('(max-width: 900px)').matches) return;
        const point = markerRenderPoint(marker);
        const markerX = point.x * viewport.clientWidth * scale + offsetX;
        const markerY = point.y * viewport.clientHeight * scale + offsetY;
        const panelWidth = panel.offsetWidth || 0;
        const panelHeight = panel.offsetHeight || 0;
        const unsafeRight = viewport.clientWidth - panelWidth - 40;
        const unsafeTop = 24;
        const unsafeBottom = panelHeight + 24;
        let changed = false;
        if (markerX > unsafeRight && markerY < unsafeBottom) {
          offsetX -= Math.round(markerX - unsafeRight + 56);
          changed = true;
        }
        if (markerY < unsafeTop) {
          offsetY += Math.round(unsafeTop - markerY + 28);
          changed = true;
        }
        if (changed) setTransform();
      }

      function visibleCategories() {
        return new Set(filters.filter((input) => input.checked).map((input) => input.value));
      }

      function normalizeSearchText(value) {
        return String(value || '').normalize('NFKC').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
      }

      function markerMatches(marker, query) {
        const localized = localizedMarker(marker);
        const haystack = normalizeSearchText(`${marker.name} ${marker.region} ${marker.subtype || ''} ${(marker.aliases || []).join(' ')} ${(localized.search_aliases || []).join(' ')}`);
        return !query || haystack.includes(query);
      }

      function markerMatchesChestRegion(marker) {
        return !chestRegionFilter || !chestRegionFilter.value || marker.chunk_key === chestRegionFilter.value;
      }

      function clusterChestMarkers(markers) {
        const cell = scale < 1 ? 150 : scale < 1.45 ? 96 : 36;
        const buckets = new Map();
        markers.forEach((marker) => {
          const key = `${Math.floor(marker.x * viewport.clientWidth * scale / cell)}:${Math.floor(marker.y * viewport.clientHeight * scale / cell)}`;
          const bucket = buckets.get(key) || { count: 0, x: 0, y: 0, markers: [] };
          bucket.count += 1;
          bucket.x += marker.x;
          bucket.y += marker.y;
          if (bucket.markers.length < 6) bucket.markers.push(marker);
          buckets.set(key, bucket);
        });
        return Array.from(buckets.values()).map((bucket) => ({
          count: bucket.count,
          x: bucket.x / bucket.count,
          y: bucket.y / bucket.count,
          markers: bucket.markers,
        }));
      }

      function renderChestLayer() {
        if (!chestLayer || !root.dataset.chestLoaded) return;
        const query = normalizeSearchText(search.value);
        const categories = visibleCategories();
        if (!categories.has('CHEST')) {
          chestLayer.innerHTML = '';
          return;
        }

        const visibleChestMarkers = chestMarkers.filter((marker) =>
          markerMatches(marker, query) &&
          markerMatchesChestRegion(marker) &&
          (!hideCompleted?.checked || !completedMarkerIds.has(marker.id))
        );
        if (scale < 1.45) {
          const clusters = clusterChestMarkers(visibleChestMarkers);
          chestLayer.innerHTML = clusters.map((cluster, index) => `
            <button
              type="button"
              class="chest-cluster"
              data-chest-cluster
              data-cluster-x="${cluster.x}"
              data-cluster-y="${cluster.y}"
              style="left:${cluster.x * 100}%;top:${cluster.y * 100}%;"
              aria-label="${cluster.count} ${escapeHtml(chestLabels.clusterLabel || 'Treasure Chests')}"
            >${cluster.count}</button>
          `).join('');
          return;
        }

        const focusedRegion = Boolean(chestRegionFilter?.value);
        const individualLimit = focusedRegion ? 520 : maxIndividualChestMarkers;
        const renderedChestMarkers = visibleChestMarkers.slice(0, individualLimit);
        chestLayer.innerHTML = renderedChestMarkers.map((marker) => `
          ${(() => {
            const localized = localizedMarker(marker);
            return `
          <button
            type="button"
            class="marker marker-chest"
            data-marker-id="${marker.id}"
            data-marker-category="CHEST"
            data-marker-status="${marker.verification_status}"
            data-marker-name="${escapeHtml(localized.display_name || marker.name)}"
            data-marker-region="${escapeHtml(localized.display_region || marker.region)}"
            data-marker-subtype="${marker.subtype || ''}"
            data-marker-aliases="${escapeHtml((localized.search_aliases || []).join(' '))}"
            ${completedMarkerIds.has(marker.id) ? 'data-marker-completed' : ''}
            style="left:${marker.x * 100}%;top:${marker.y * 100}%;"
            aria-label="${escapeHtml(localized.display_name || marker.name)}, ${escapeHtml(localized.display_region || marker.region)}, ${escapeHtml(String(marker.precision).toLowerCase())}"
          ><span aria-hidden="true"></span></button>
            `;
          })()}
        `).join('');
        root.dataset.chestRenderedCount = String(renderedChestMarkers.length);
        root.dataset.chestRenderLimited = visibleChestMarkers.length > renderedChestMarkers.length ? 'true' : 'false';
      }

      async function loadChestMarkers() {
        if (root.dataset.chestLoaded || !chestManifestUrl) return;
        if (!chestLoadPromise) {
          chestLoadPromise = fetch(chestManifestUrl)
            .then((response) => response.ok ? response.json() : Promise.reject(new Error(`Chest manifest ${response.status}`)))
            .then(async (manifest) => {
              if (chestRegionFilter) {
                chestRegionFilter.innerHTML = `<option value="">${escapeHtml(mapLabels.controls?.allLoadedRegions || 'All loaded regions')}</option>` + (manifest.regions || []).map((region) =>
                  `<option value="${escapeHtml(region.slug)}">${escapeHtml(localizedRegion(region.name))} (${region.marker_count})</option>`
                ).join('');
                chestRegionFilter.disabled = false;
              }
              const chunks = await Promise.all((manifest.regions || []).map((region) =>
                fetch(`/data/map/chests/${region.chunk}`)
                  .then((response) => response.ok ? response.json() : Promise.reject(new Error(`Chest chunk ${region.chunk} ${response.status}`)))
              ));
              chestMarkers.splice(0, chestMarkers.length, ...chunks.flatMap((chunk) => chunk.markers || []).map((marker, index) => ({
                ...marker,
                category: 'CHEST',
                original_x: marker.x,
                original_y: marker.y,
                ...(() => {
                  const point = transformCoordinate(marker.x, marker.y, marker.region || marker.chunk_key || '');
                  return { x: point.x, y: point.y, render_x: point.x, render_y: point.y };
                })(),
                verification_status: marker.verification_status || marker.status,
                display_name: localizedChestName(marker, index),
              })));
              root.dataset.chestLoaded = 'true';
              root.dataset.chestPublishedCount = String(chestMarkers.length);
            })
            .catch((error) => {
              root.dataset.chestLoadError = String(error.message || error);
              throw error;
            });
        }
        await chestLoadPromise;
      }

      async function applyFilters() {
        const query = normalizeSearchText(search.value);
        const categories = visibleCategories();
        if (categories.has('CHEST')) await loadChestMarkers();
        let shown = 0;

        Array.from(root.querySelectorAll('[data-marker-id]:not(.marker-chest)')).forEach((button) => {
          const haystack = normalizeSearchText(`${button.dataset.markerName} ${button.dataset.markerRegion} ${button.dataset.markerSubtype} ${button.dataset.markerAliases}`);
          const visible = categories.has(button.dataset.markerCategory) &&
            (!query || haystack.includes(query)) &&
            (!hideCompleted?.checked || !completedMarkerIds.has(button.dataset.markerId));
          button.hidden = !visible;
          if (visible) shown += 1;
        });

        renderChestLayer();
        if (categories.has('CHEST')) {
          shown += chestMarkers.filter((marker) =>
            markerMatches(marker, query) &&
            markerMatchesChestRegion(marker) &&
            (!hideCompleted?.checked || !completedMarkerIds.has(marker.id))
          ).length;
        }
        root.dataset.filteredMarkerCount = String(shown);
      }

      async function toggleSelectedMarkerCompletion() {
        const marker = allMarkers().find((item) => item.id === selectedMarkerId);
        if (!marker) return;
        const completed = !completedMarkerIds.has(marker.id);
        if (completed) completedMarkerIds.add(marker.id);
        else completedMarkerIds.delete(marker.id);
        persistCompletedMarkerIds();
        syncCompletionUi();
        await applyFilters();
        trackToolEvent('map_marker_completed', {
          marker_id: marker.id,
          marker_category: marker.category,
          completed,
        });
      }

      async function resetCompletedMarkers() {
        completedMarkerIds.clear();
        persistCompletedMarkerIds();
        syncCompletionUi();
        await applyFilters();
        trackToolEvent('tool_reset', { reset_scope: 'map_completed_markers' });
      }

      async function selectDeepLinkedMarker() {
        const markerId = new URLSearchParams(window.location.search).get('marker');
        if (!markerId) return;
        let marker = baseMarkers.find((item) => item.id === markerId);
        if (!marker && markerId.startsWith('marker:chest:')) {
          const chestFilter = filters.find((input) => input.value === 'CHEST');
          if (chestFilter) chestFilter.checked = true;
          await loadChestMarkers();
          marker = chestMarkers.find((item) => item.id === markerId);
          if (marker) {
            if (chestRegionFilter && marker.chunk_key) chestRegionFilter.value = marker.chunk_key;
            scale = Math.max(scale, 1.55);
            offsetX = Math.round(viewport.clientWidth / 2 - marker.x * viewport.clientWidth * scale);
            offsetY = Math.round(viewport.clientHeight / 2 - marker.y * viewport.clientHeight * scale);
            setTransform();
            await applyFilters();
          }
        }
        if (marker) selectMarker(markerId, { updateUrl: false });
      }

      function zoomBy(amount) {
        scale = Math.min(2.4, Math.max(0.8, Number((scale + amount).toFixed(2))));
        setTransform();
      }

      root.addEventListener('click', (event) => {
        const actionButton = event.target.closest('[data-map-action]');
        if (actionButton) {
          const action = actionButton.dataset.mapAction;
          if (action === 'zoom-in') zoomBy(0.2);
          if (action === 'zoom-out') zoomBy(-0.2);
          if (action === 'reset') {
            scale = 1;
            offsetX = 0;
            offsetY = 0;
            setTransform();
          }
          if (action === 'toggle-completed') void toggleSelectedMarkerCompletion();
          if (action === 'reset-completed') void resetCompletedMarkers();
        }

        const markerButton = event.target.closest('[data-marker-id]');
        if (markerButton) {
          selectMarker(markerButton.dataset.markerId);
        }

        const clusterButton = event.target.closest('[data-chest-cluster]');
        if (clusterButton) {
          const x = Number(clusterButton.dataset.clusterX);
          const y = Number(clusterButton.dataset.clusterY);
          scale = Math.min(2.4, Math.max(1.55, Number((scale + 0.55).toFixed(2))));
          offsetX = Math.round(viewport.clientWidth / 2 - x * viewport.clientWidth * scale);
          offsetY = Math.round(viewport.clientHeight / 2 - y * viewport.clientHeight * scale);
          setTransform();
          void applyFilters();
        }
      });

      viewport.addEventListener('pointerdown', (event) => {
        if (event.target.closest('[data-marker-id]')) return;
        dragStart = { x: event.clientX, y: event.clientY, offsetX, offsetY };
        viewport.setPointerCapture(event.pointerId);
      });

      viewport.addEventListener('pointermove', (event) => {
        if (!dragStart) return;
        offsetX = dragStart.offsetX + event.clientX - dragStart.x;
        offsetY = dragStart.offsetY + event.clientY - dragStart.y;
        setTransform();
      });

      viewport.addEventListener('pointerup', () => {
        dragStart = null;
      });

      viewport.addEventListener('wheel', (event) => {
        event.preventDefault();
        zoomBy(event.deltaY > 0 ? -0.12 : 0.12);
      }, { passive: false });

      search.addEventListener('input', () => void applyFilters());
      search.addEventListener('change', () => trackToolEvent('tool_input_change', { input_name: 'search' }));
      filters.forEach((input) => input.addEventListener('change', () => {
        void applyFilters();
        trackToolEvent('tool_input_change', { input_name: 'category', input_value: input.value, enabled: input.checked });
      }));
      hideCompleted?.addEventListener('change', () => {
        void applyFilters();
        trackToolEvent('tool_input_change', { input_name: 'hide_completed', enabled: hideCompleted.checked });
      });
      chestRegionFilter?.addEventListener('change', () => {
        void applyFilters();
        trackToolEvent('tool_input_change', { input_name: 'chest_region', input_value: chestRegionFilter.value });
      });
      syncCompletionUi();
      setTransform();
      trackToolEvent('tool_open');
      void applyFilters().then(selectDeepLinkedMarker);
    })();
  </script>
</section>

