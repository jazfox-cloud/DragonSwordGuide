---
interface Marker {
  id: string;
  name: string;
  category: 'EONAS_LEGACY' | 'ORGANA_STATUE' | 'WARP_POINT' | 'DUNGEON' | 'BOSS' | 'CHEST';
  subtype?: string;
  region: string;
  x: number;
  y: number;
  precision: string;
  verification_status: string;
  confidence: string;
  source_summary: string;
  game_version: string;
  last_checked: string;
  description: string;
  aliases?: string[];
  navigation_note?: string;
  activity_note?: string;
  location_note?: string;
}

interface MarkerData {
  base_map_id: string;
  coordinate_system: string;
  data_policy: string;
  source_boundary: string;
  game_version: string;
  last_checked: string;
  category_status?: {
    ORGANA_STATUE?: {
      count_conflict?: string;
      conflict_verdict?: string;
    };
  };
  markers: Marker[];
}

const { markerData } = Astro.props as { markerData: MarkerData };
const { chestMarkerCount = 0 } = Astro.props as { chestMarkerCount?: number };
const { labels: suppliedLabels = {}, locale = 'en' } = Astro.props as { labels?: Record<string, any>; locale?: 'en' | 'ja' };
const defaultLabels = {
  headings: {
    eyebrow: 'Interactive beta · Unofficial schematic',
    title: 'DragonSword Awakening Interactive Map Beta',
    description: 'Search, filter, pan and zoom approximate Orbis markers while exact routes are still being verified.',
    betaMarkers: 'beta markers',
    chests: 'chests',
    firstHandVerified: 'first-hand verified',
    markerSummary: 'Map marker summary',
    viewportLabel: 'Unofficial schematic Orbis map. Drag to pan and use controls to zoom.',
    schematicTitle: 'Unofficial schematic map of Orbis',
    schematicDescription: 'An owned, approximate schematic base map for DragonSword Awakening beta markers. Not to exact in-game scale.',
    schematicLabel: 'Unofficial schematic map',
    scaleNote: 'Not to exact in-game scale',
  },
  categories: {
    EONAS_LEGACY: "Eona's Legacy",
    ORGANA_STATUE: 'Organa Statues',
    WARP_POINT: 'Warp Points',
    DUNGEON: 'Dungeons',
    BOSS: 'Bosses',
    CHEST: 'Treasure Chests',
  },
  statuses: {
    OFFICIAL_VERIFIED: 'Official verified',
    FIRST_HAND_VERIFIED: 'First-hand verified',
    VIDEO_VERIFIED: 'Video verified',
    SECONDARY_CORROBORATED: 'Source corroborated',
    APPROXIMATE: 'Approximate',
    CONFLICTING: 'Conflicting',
  },
  controls: {
    toolbar: 'Interactive map controls',
    searchLabel: 'Search markers',
    searchPlaceholder: 'Search name or region',
    filters: 'Marker categories',
    chestRegion: 'Chest region',
    allLoadedRegions: 'All loaded regions',
    zoomControls: 'Map view controls',
    zoomIn: 'Zoom in',
    zoomOut: 'Zoom out',
    reset: 'Reset',
    noMatches: 'No matching locations',
  },
  panel: {
    region: 'Region',
    subtype: 'Subtype',
    bossType: 'Boss type',
    precision: 'Precision',
    status: 'Status',
    confidence: 'Confidence',
  },
  chest: {
    displayPrefix: 'Treasure Chest',
    clusterLabel: 'Treasure Chests',
    subtypeLabels: {},
  },
  regions: {},
};
const mapLabels = {
  ...defaultLabels,
  ...suppliedLabels,
  headings: { ...defaultLabels.headings, ...(suppliedLabels.headings || {}) },
  categories: { ...defaultLabels.categories, ...(suppliedLabels.categories || {}) },
  statuses: { ...defaultLabels.statuses, ...(suppliedLabels.statuses || {}) },
  controls: { ...defaultLabels.controls, ...(suppliedLabels.controls || {}) },
  panel: { ...defaultLabels.panel, ...(suppliedLabels.panel || {}) },
  chest: { ...defaultLabels.chest, ...(suppliedLabels.chest || {}) },
  regions: { ...defaultLabels.regions, ...(suppliedLabels.regions || {}) },
};
const categoryLabels = mapLabels.categories;
const statusLabels = mapLabels.statuses;
const regionLabel = (region: string) => mapLabels.regions[region] || region;
const categoryCounts = markerData.markers.reduce<Record<string, number>>((counts, marker) => {
  counts[marker.category] = (counts[marker.category] || 0) + 1;
  return counts;
}, {});
categoryCounts.CHEST = chestMarkerCount;
const firstMarker = markerData.markers[0];
---

<section
  class="interactive-map"
  data-map-mvp
  data-base-map-id={markerData.base_map_id}
  data-coordinate-system={markerData.coordinate_system}
  data-organa-count-conflict={markerData.category_status?.ORGANA_STATUE?.count_conflict}
  data-organa-conflict-verdict={markerData.category_status?.ORGANA_STATUE?.conflict_verdict}
  data-marker-count={markerData.markers.length + chestMarkerCount}
  data-chest-marker-count={chestMarkerCount}
  data-chest-manifest-url="/data/map/chests/manifest.json"
  data-locale={locale}
  aria-labelledby="interactive-map-title"
>
  <div class="map-heading">
    <div>
      <p class="eyebrow">{mapLabels.headings.eyebrow}</p>
      <h2 id="interactive-map-title">{mapLabels.headings.title}</h2>
      <p>{mapLabels.headings.description}</p>
    </div>
    <div class="map-stats" aria-label={mapLabels.headings.markerSummary}>
      <span><strong>{markerData.markers.length + chestMarkerCount}</strong> {mapLabels.headings.betaMarkers}</span>
      <span><strong>{chestMarkerCount}</strong> {mapLabels.headings.chests}</span>
      <span><strong>0</strong> {mapLabels.headings.firstHandVerified}</span>
    </div>
  </div>

  <div class="map-toolbar" aria-label={mapLabels.controls.toolbar}>
    <label class="search-field">
      <span>{mapLabels.controls.searchLabel}</span>
      <input data-marker-search type="search" placeholder={mapLabels.controls.searchPlaceholder} autocomplete="off" />
    </label>
    <div class="filter-group" aria-label={mapLabels.controls.filters}>
      {Object.entries(categoryLabels).map(([category, label]) => (
        <label class="filter-pill">
          <input data-category-filter type="checkbox" value={category} checked={category !== 'CHEST'} />
          <span>{label} <small>{categoryCounts[category] || 0}</small></span>
        </label>
      ))}
    </div>
    <label class="chest-region-field">
      <span>{mapLabels.controls.chestRegion}</span>
      <select data-chest-region-filter disabled>
        <option value="">{mapLabels.controls.allLoadedRegions}</option>
      </select>
    </label>
    <div class="zoom-actions" aria-label={mapLabels.controls.zoomControls}>
      <button type="button" data-map-action="zoom-out" aria-label={mapLabels.controls.zoomOut}>-</button>
      <button type="button" data-map-action="reset">{mapLabels.controls.reset}</button>
      <button type="button" data-map-action="zoom-in" aria-label={mapLabels.controls.zoomIn}>+</button>
    </div>
  </div>

  <div class="map-workspace">
    <div class="map-frame">
      <div class="map-viewport" data-map-viewport aria-label={mapLabels.headings.viewportLabel}>
        <div class="map-canvas" data-map-canvas>
          <svg class="schematic-map" viewBox="0 0 1000 680" role="img" aria-labelledby="orbis-map-title orbis-map-desc">
            <title id="orbis-map-title">{mapLabels.headings.schematicTitle}</title>
            <desc id="orbis-map-desc">{mapLabels.headings.schematicDescription}</desc>
            <rect width="1000" height="680" rx="8" fill="#0c1726" />
            <path d="M80 462 C146 346 251 288 370 303 C465 190 615 151 735 226 C849 278 905 389 851 486 C765 610 570 626 451 568 C314 624 162 578 80 462 Z" fill="#193649" stroke="#61d7ff" stroke-opacity=".42" stroke-width="3" />
            <path d="M191 444 C242 372 334 352 409 382 C492 324 604 317 684 376 C746 420 772 505 709 552 C607 589 517 563 446 526 C360 561 248 540 191 444 Z" fill="#244d43" opacity=".86" />
            <path d="M341 221 L415 108 L486 230 L552 132 L660 273 Z" fill="#2c3f52" stroke="#d9f3ff" stroke-opacity=".36" stroke-width="3" />
            <path d="M686 270 C758 298 812 365 809 438 C776 415 727 407 686 424 C704 368 698 318 686 270 Z" fill="#344d36" opacity=".82" />
            <path d="M151 489 C264 536 366 534 455 493 C530 548 645 576 748 540" fill="none" stroke="#89e3c1" stroke-opacity=".42" stroke-width="7" stroke-linecap="round" />
            <path d="M506 171 C513 251 502 321 468 389 C439 447 443 512 486 568" fill="none" stroke="#70c8ff" stroke-opacity=".45" stroke-width="5" stroke-linecap="round" />
            <circle cx="490" cy="385" r="46" fill="#243647" stroke="#f6d675" stroke-opacity=".6" stroke-width="3" />
            <path d="M461 386 L490 354 L520 386 L490 419 Z" fill="#f6d675" opacity=".68" />
            <text x="490" y="462" text-anchor="middle" fill="#dcecff" font-size="28" font-weight="700">Central Orbis</text>
            <text x="249" y="356" text-anchor="middle" fill="#b9d4e6" font-size="22" font-weight="700">Meadow Approach</text>
            <text x="514" y="92" text-anchor="middle" fill="#b9d4e6" font-size="22" font-weight="700">Shadowed Woods</text>
            <text x="750" y="334" text-anchor="middle" fill="#b9d4e6" font-size="22" font-weight="700">Eastern Highlands</text>
            <text x="610" y="626" text-anchor="middle" fill="#b9d4e6" font-size="22" font-weight="700">Dragonrise Basin</text>
            <text x="24" y="48" fill="#dcecff" font-size="24" font-weight="800">{mapLabels.headings.schematicLabel}</text>
            <text x="24" y="82" fill="#9fb1c4" font-size="20">{mapLabels.headings.scaleNote}</text>
          </svg>
          {markerData.markers.map((marker) => (
            <button
              type="button"
              class={`marker marker-${marker.category.toLowerCase().replace('_', '-')}`}
              data-marker-id={marker.id}
              data-marker-category={marker.category}
              data-marker-status={marker.verification_status}
              data-marker-name={marker.name}
              data-marker-region={regionLabel(marker.region)}
              data-marker-subtype={marker.subtype || ''}
              data-marker-aliases={[...(marker.aliases || []), categoryLabels[marker.category], marker.region, regionLabel(marker.region)].join(' ')}
              style={`left:${marker.x * 100}%;top:${marker.y * 100}%;`}
              aria-label={`${marker.name}, ${regionLabel(marker.region)}, ${marker.precision.toLowerCase()}`}
            >
              <span aria-hidden="true"></span>
            </button>
          ))}
          <div class="chest-layer" data-chest-layer aria-live="polite"></div>
        </div>
      </div>
      <div class="map-scale-note">
        <span>{markerData.base_map_id}</span>
        <span>{markerData.coordinate_system}</span>
      </div>
    </div>

    <aside class="marker-panel" data-marker-panel aria-live="polite">
      <p class="panel-kicker">{categoryLabels[firstMarker.category]}</p>
      <h3>{firstMarker.name}</h3>
      <span class={`status-badge status-${firstMarker.verification_status.toLowerCase().replaceAll('_', '-')}`}>{statusLabels[firstMarker.verification_status]}</span>
      <dl>
        <div><dt>{mapLabels.panel.region}</dt><dd>{regionLabel(firstMarker.region)}</dd></div>
        {firstMarker.subtype && <div><dt>{firstMarker.category === 'BOSS' ? mapLabels.panel.bossType : mapLabels.panel.subtype}</dt><dd>{firstMarker.subtype}</dd></div>}
        <div><dt>{mapLabels.panel.precision}</dt><dd>{firstMarker.precision}</dd></div>
        <div><dt>{mapLabels.panel.status}</dt><dd>{firstMarker.verification_status}</dd></div>
        <div><dt>{mapLabels.panel.confidence}</dt><dd>{firstMarker.confidence}</dd></div>
      </dl>
      <p>{firstMarker.description}</p>
      {firstMarker.activity_note && <p class="activity-note">{firstMarker.activity_note}</p>}
      {firstMarker.location_note && <p class="location-note">{firstMarker.location_note}</p>}
      <p class="source-note">{firstMarker.source_summary}</p>
      {firstMarker.navigation_note && <p class="navigation-note">{firstMarker.navigation_note}</p>}
    </aside>
  </div>

  <p class="map-boundary">{markerData.source_boundary}</p>
  <script type="application/json" id="map-marker-data" set:html={JSON.stringify(markerData.markers)} />
  <script type="application/json" id="map-label-data" set:html={JSON.stringify(mapLabels)} />
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-map-mvp]');
      if (!root) return;

      const markerDataScript = root.querySelector('#map-marker-data');
      const labelDataScript = root.querySelector('#map-label-data');
      const baseMarkers = JSON.parse(markerDataScript.textContent || '[]');
      const mapLabels = JSON.parse(labelDataScript.textContent || '{}');
      const canvas = root.querySelector('[data-map-canvas]');
      const viewport = root.querySelector('[data-map-viewport]');
      const panel = root.querySelector('[data-marker-panel]');
      const search = root.querySelector('[data-marker-search]');
      const filters = Array.from(root.querySelectorAll('[data-category-filter]'));
      const chestRegionFilter = root.querySelector('[data-chest-region-filter]');
      const chestLayer = root.querySelector('[data-chest-layer]');
      const chestManifestUrl = root.dataset.chestManifestUrl;
      const labels = mapLabels.categories || {};
      const statusLabels = mapLabels.statuses || {};
      const panelLabels = mapLabels.panel || {};
      const chestLabels = mapLabels.chest || {};
      const regionLabels = mapLabels.regions || {};
      const chestMarkers = [];
      let chestLoadPromise = null;
      let scale = 1;
      let offsetX = 0;
      let offsetY = 0;
      let dragStart = null;

      function setTransform() {
        canvas.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
        renderChestLayer();
      }

      function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        }[char]));
      }

      function localizedRegion(region) {
        return regionLabels[region] || region;
      }

      function localizedChestName(marker, index = 0) {
        const raw = String(marker.id || index + 1);
        const numeric = raw.match(/\d+/g)?.join('').slice(-4) || String(index + 1);
        return `${chestLabels.displayPrefix || 'Treasure Chest'} #${numeric} — ${localizedRegion(marker.region || marker.chunk_key || '')}`;
      }

      function localizedMarker(marker) {
        if (marker.category !== 'CHEST') {
          return {
            ...marker,
            display_name: marker.name,
            display_region: localizedRegion(marker.region),
            search_aliases: [
              marker.name,
              marker.region,
              localizedRegion(marker.region),
              labels[marker.category],
              marker.subtype,
              ...(marker.aliases || []),
            ],
          };
        }
        const displayName = marker.display_name || localizedChestName(marker);
        const subtypeLabel = chestLabels.subtypeLabels?.[marker.subtype] || marker.subtype || '';
        return {
          ...marker,
          display_name: displayName,
          display_region: localizedRegion(marker.region),
          search_aliases: [
            displayName,
            marker.name,
            marker.region,
            localizedRegion(marker.region),
            marker.subtype,
            subtypeLabel,
            labels.CHEST,
            ...(marker.aliases || []),
          ],
        };
      }

      function markerButtons() {
        return Array.from(root.querySelectorAll('[data-marker-id]'));
      }

      function allMarkers() {
        return baseMarkers.concat(chestMarkers);
      }

      function renderPanel(marker) {
        const localized = localizedMarker(marker);
        const navigationNote = marker.navigation_note ? `<p class="navigation-note">${escapeHtml(marker.navigation_note)}</p>` : '';
        const subtypeLabel = marker.category === 'BOSS' ? panelLabels.bossType || 'Boss type' : panelLabels.subtype || 'Subtype';
        const subtypeRow = marker.subtype ? `<div><dt>${escapeHtml(subtypeLabel)}</dt><dd>${escapeHtml(marker.subtype)}</dd></div>` : '';
        const activityNote = marker.activity_note ? `<p class="activity-note">${escapeHtml(marker.activity_note)}</p>` : '';
        const locationNote = marker.location_note ? `<p class="location-note">${escapeHtml(marker.location_note)}</p>` : '';
        panel.innerHTML = `
          <p class="panel-kicker">${escapeHtml(labels[marker.category] || marker.category)}</p>
          <h3>${escapeHtml(localized.display_name || marker.name)}</h3>
          <span class="status-badge status-${marker.verification_status.toLowerCase().replaceAll('_', '-')}">${escapeHtml(statusLabels[marker.verification_status] || marker.verification_status)}</span>
          <dl>
            <div><dt>${escapeHtml(panelLabels.region || 'Region')}</dt><dd>${escapeHtml(localized.display_region || marker.region)}</dd></div>
            ${subtypeRow}
            <div><dt>${escapeHtml(panelLabels.precision || 'Precision')}</dt><dd>${escapeHtml(marker.precision)}</dd></div>
            <div><dt>${escapeHtml(panelLabels.status || 'Status')}</dt><dd>${escapeHtml(marker.verification_status)}</dd></div>
            <div><dt>${escapeHtml(panelLabels.confidence || 'Confidence')}</dt><dd>${escapeHtml(marker.confidence)}</dd></div>
          </dl>
          <p>${escapeHtml(marker.description)}</p>
          ${activityNote}
          ${locationNote}
          <p class="source-note">${escapeHtml(marker.source_summary)}</p>
          ${navigationNote}
        `;
      }

      function selectMarker(id) {
        const marker = allMarkers().find((item) => item.id === id);
        if (!marker) return;
        markerButtons().forEach((button) => button.toggleAttribute('data-active-marker', button.dataset.markerId === id));
        renderPanel(marker);
      }

      function visibleCategories() {
        return new Set(filters.filter((input) => input.checked).map((input) => input.value));
      }

      function normalizeSearchText(value) {
        return String(value || '').normalize('NFKC').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
      }

      function markerMatches(marker, query) {
        const localized = localizedMarker(marker);
        const haystack = normalizeSearchText(`${marker.name} ${marker.region} ${marker.subtype || ''} ${(marker.aliases || []).join(' ')} ${(localized.search_aliases || []).join(' ')}`);
        return !query || haystack.includes(query);
      }

      function markerMatchesChestRegion(marker) {
        return !chestRegionFilter || !chestRegionFilter.value || marker.chunk_key === chestRegionFilter.value;
      }

      function clusterChestMarkers(markers) {
        const cell = scale < 1 ? 64 : scale < 1.45 ? 42 : 24;
        const buckets = new Map();
        markers.forEach((marker) => {
          const key = `${Math.floor(marker.x * viewport.clientWidth * scale / cell)}:${Math.floor(marker.y * viewport.clientHeight * scale / cell)}`;
          const bucket = buckets.get(key) || { count: 0, x: 0, y: 0, markers: [] };
          bucket.count += 1;
          bucket.x += marker.x;
          bucket.y += marker.y;
          if (bucket.markers.length < 6) bucket.markers.push(marker);
          buckets.set(key, bucket);
        });
        return Array.from(buckets.values()).map((bucket) => ({
          count: bucket.count,
          x: bucket.x / bucket.count,
          y: bucket.y / bucket.count,
          markers: bucket.markers,
        }));
      }

      function renderChestLayer() {
        if (!chestLayer || !root.dataset.chestLoaded) return;
        const query = normalizeSearchText(search.value);
        const categories = visibleCategories();
        if (!categories.has('CHEST')) {
          chestLayer.innerHTML = '';
          return;
        }

        const visibleChestMarkers = chestMarkers.filter((marker) => markerMatches(marker, query) && markerMatchesChestRegion(marker));
        if (scale < 1.45) {
          const clusters = clusterChestMarkers(visibleChestMarkers);
          chestLayer.innerHTML = clusters.map((cluster, index) => `
            <button
              type="button"
              class="chest-cluster"
              data-chest-cluster
              data-cluster-x="${cluster.x}"
              data-cluster-y="${cluster.y}"
              style="left:${cluster.x * 100}%;top:${cluster.y * 100}%;"
              aria-label="${cluster.count} ${escapeHtml(chestLabels.clusterLabel || 'Treasure Chests')}"
            >${cluster.count}</button>
          `).join('');
          return;
        }

        chestLayer.innerHTML = visibleChestMarkers.slice(0, 250).map((marker) => `
          ${(() => {
            const localized = localizedMarker(marker);
            return `
          <button
            type="button"
            class="marker marker-chest"
            data-marker-id="${marker.id}"
            data-marker-category="CHEST"
            data-marker-status="${marker.verification_status}"
            data-marker-name="${escapeHtml(localized.display_name || marker.name)}"
            data-marker-region="${escapeHtml(localized.display_region || marker.region)}"
            data-marker-subtype="${marker.subtype || ''}"
            data-marker-aliases="${escapeHtml((localized.search_aliases || []).join(' '))}"
            style="left:${marker.x * 100}%;top:${marker.y * 100}%;"
            aria-label="${escapeHtml(localized.display_name || marker.name)}, ${escapeHtml(localized.display_region || marker.region)}, ${escapeHtml(String(marker.precision).toLowerCase())}"
          ><span aria-hidden="true"></span></button>
            `;
          })()}
        `).join('');
      }

      async function loadChestMarkers() {
        if (root.dataset.chestLoaded || !chestManifestUrl) return;
        if (!chestLoadPromise) {
          chestLoadPromise = fetch(chestManifestUrl)
            .then((response) => response.ok ? response.json() : Promise.reject(new Error(`Chest manifest ${response.status}`)))
            .then(async (manifest) => {
              if (chestRegionFilter) {
                chestRegionFilter.innerHTML = `<option value="">${escapeHtml(mapLabels.controls?.allLoadedRegions || 'All loaded regions')}</option>` + (manifest.regions || []).map((region) =>
                  `<option value="${escapeHtml(region.slug)}">${escapeHtml(localizedRegion(region.name))} (${region.marker_count})</option>`
                ).join('');
                chestRegionFilter.disabled = false;
              }
              const chunks = await Promise.all((manifest.regions || []).map((region) =>
                fetch(`/data/map/chests/${region.chunk}`)
                  .then((response) => response.ok ? response.json() : Promise.reject(new Error(`Chest chunk ${region.chunk} ${response.status}`)))
              ));
              chestMarkers.splice(0, chestMarkers.length, ...chunks.flatMap((chunk) => chunk.markers || []).map((marker, index) => ({
                ...marker,
                category: 'CHEST',
                verification_status: marker.verification_status || marker.status,
                display_name: localizedChestName(marker, index),
              })));
              root.dataset.chestLoaded = 'true';
              root.dataset.chestPublishedCount = String(chestMarkers.length);
            })
            .catch((error) => {
              root.dataset.chestLoadError = String(error.message || error);
              throw error;
            });
        }
        await chestLoadPromise;
      }

      async function applyFilters() {
        const query = normalizeSearchText(search.value);
        const categories = visibleCategories();
        if (categories.has('CHEST')) await loadChestMarkers();
        let shown = 0;

        Array.from(root.querySelectorAll('[data-marker-id]:not(.marker-chest)')).forEach((button) => {
          const haystack = normalizeSearchText(`${button.dataset.markerName} ${button.dataset.markerRegion} ${button.dataset.markerSubtype} ${button.dataset.markerAliases}`);
          const visible = categories.has(button.dataset.markerCategory) && (!query || haystack.includes(query));
          button.hidden = !visible;
          if (visible) shown += 1;
        });

        renderChestLayer();
        if (categories.has('CHEST')) {
          shown += chestMarkers.filter((marker) => markerMatches(marker, query) && markerMatchesChestRegion(marker)).length;
        }
        root.dataset.filteredMarkerCount = String(shown);
      }

      function zoomBy(amount) {
        scale = Math.min(2.4, Math.max(0.8, Number((scale + amount).toFixed(2))));
        setTransform();
      }

      root.addEventListener('click', (event) => {
        const actionButton = event.target.closest('[data-map-action]');
        if (actionButton) {
          const action = actionButton.dataset.mapAction;
          if (action === 'zoom-in') zoomBy(0.2);
          if (action === 'zoom-out') zoomBy(-0.2);
          if (action === 'reset') {
            scale = 1;
            offsetX = 0;
            offsetY = 0;
            setTransform();
          }
        }

        const markerButton = event.target.closest('[data-marker-id]');
        if (markerButton) {
          selectMarker(markerButton.dataset.markerId);
        }

        const clusterButton = event.target.closest('[data-chest-cluster]');
        if (clusterButton) {
          const x = Number(clusterButton.dataset.clusterX);
          const y = Number(clusterButton.dataset.clusterY);
          scale = Math.min(2.4, Math.max(1.55, Number((scale + 0.55).toFixed(2))));
          offsetX = Math.round(viewport.clientWidth / 2 - x * viewport.clientWidth * scale);
          offsetY = Math.round(viewport.clientHeight / 2 - y * viewport.clientHeight * scale);
          setTransform();
          void applyFilters();
        }
      });

      viewport.addEventListener('pointerdown', (event) => {
        if (event.target.closest('[data-marker-id]')) return;
        dragStart = { x: event.clientX, y: event.clientY, offsetX, offsetY };
        viewport.setPointerCapture(event.pointerId);
      });

      viewport.addEventListener('pointermove', (event) => {
        if (!dragStart) return;
        offsetX = dragStart.offsetX + event.clientX - dragStart.x;
        offsetY = dragStart.offsetY + event.clientY - dragStart.y;
        setTransform();
      });

      viewport.addEventListener('pointerup', () => {
        dragStart = null;
      });

      viewport.addEventListener('wheel', (event) => {
        event.preventDefault();
        zoomBy(event.deltaY > 0 ? -0.12 : 0.12);
      }, { passive: false });

      search.addEventListener('input', () => void applyFilters());
      filters.forEach((input) => input.addEventListener('change', () => void applyFilters()));
      chestRegionFilter?.addEventListener('change', () => void applyFilters());
      setTransform();
      void applyFilters();
    })();
  </script>
</section>

