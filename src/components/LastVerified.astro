---
interface Props {
  date: string;
  gameVersion?: string;
  label?: string;
  gameVersionLabel?: string;
}

const { date, gameVersion, label = 'Last verified', gameVersionLabel = 'Game version' } = Astro.props;
---

<p class="meta">
  {label}: {date}
  {gameVersion && <><span aria-hidden="true"> · </span>{gameVersionLabel}: {gameVersion}</>}
</p>

<style>
  .meta { color: var(--muted); font-size: 0.82rem; }
</style>
