---
interface Source {
  label: string;
  href: string;
  note: string;
}

interface Props {
  sources: Source[];
  title?: string;
  intro?: string;
}

const {
  sources,
  title = 'Sources & verification',
  intro = 'Evidence level: B (primary-source verified), with C (community verification) clearly labeled where live behavior could not be confirmed.',
} = Astro.props;
---

<section class="sources" aria-labelledby="sources-title">
  <h2 id="sources-title">{title}</h2>
  <p>{intro}</p>
  <ol>
    {sources.map((source) => <li><a href={source.href}>{source.label}</a> — {source.note}</li>)}
  </ol>
</section>

<style>
  .sources { max-width: 760px; border-top: 1px solid var(--line); margin-top: 2.5rem; padding-top: 0.25rem; }
  .sources h2 { font-size: 1.35rem; }
  .sources p, .sources li { color: var(--muted); font-size: 0.9rem; }
  .sources ol { padding-left: 1.25rem; }
  .sources li { margin: 0.6rem 0; }
</style>
