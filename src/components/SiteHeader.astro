---
import type { LocaleCode } from '../i18n/locales';
import type { RouteId } from '../i18n/routes';
import { getDictionary } from '../i18n/dictionaries';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNav from './MobileNav.astro';

interface Props {
  locale?: LocaleCode;
  routeId?: RouteId;
}

const { locale = 'en', routeId } = Astro.props;
const dictionary = getDictionary(locale);
const homeHref = locale === 'ja' ? '/ja/' : '/';
---

<header class="site-header" data-site-header data-locale={locale}>
  <div class="shell header-inner">
    <a class="brand" href={homeHref} aria-label={dictionary.shell.ariaHome}>
      <span class="brand-visual">
        <img class="brand-image" src="/brand/logo.png" alt="" width="32" height="32" loading="eager" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
        <span class="brand-mark brand-fallback" aria-hidden="true" hidden><span></span></span>
      </span>
      <span>{dictionary.brand}</span>
    </a>
    <nav class="site-nav" aria-label={dictionary.shell.primaryNav} data-global-nav>
      {dictionary.nav.map((item) => (
        <a href={item.href} data-route-id={item.routeId} aria-current={routeId === item.routeId ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <LanguageSwitcher locale={locale} routeId={routeId} />
    <span class="brand-note">{dictionary.shell.note}</span>
    <MobileNav locale={locale} routeId={routeId} />
  </div>
</header>
