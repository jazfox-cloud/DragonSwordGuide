---
interface Props { label: string; }
const { label } = Astro.props;
---
<span class="badge">{label}</span>
<style>
  .badge { display: inline-flex; width: fit-content; color: var(--success); border: 1px solid hsl(165 62% 63% / 0.35); background: hsl(165 62% 63% / 0.08); border-radius: 999px; padding: 0.16rem 0.5rem; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.03em; }
</style>
