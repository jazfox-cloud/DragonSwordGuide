---
interface Props {
  title: string;
  eyebrow?: string;
}

const { title, eyebrow = 'Quick answer' } = Astro.props;
---

<aside class="quick-answer" aria-labelledby="quick-answer-title">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id="quick-answer-title">{title}</h2>
  <slot />
</aside>

<style>
  .quick-answer { background: var(--accent-soft); border: 1px solid hsl(199 86% 58% / 0.4); border-top: 2px solid var(--accent); padding: 1.25rem 1.2rem; margin: 1.5rem 0 2.25rem; }
  .quick-answer h2 { margin: 0 0 0.5rem; font-size: 1.45rem; }
  .quick-answer p:last-child { margin-bottom: 0; }
  .eyebrow { color: var(--accent); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; margin: 0 0 0.35rem; text-transform: uppercase; }
</style>
