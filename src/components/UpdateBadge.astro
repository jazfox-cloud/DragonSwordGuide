---
interface Props { label: string; href?: string; }
const { label, href } = Astro.props;
---
{href ? <a class="update-badge" href={href}>{label}</a> : <span class="update-badge">{label}</span>}
<style>
  .update-badge { display: inline-flex; width: fit-content; align-items: center; gap: 0.4rem; color: var(--accent-light); border: 1px solid hsl(199 86% 58% / 0.35); border-radius: 999px; padding: 0.3rem 0.6rem; font-size: 0.72rem; font-weight: 800; text-decoration: none; }
</style>
