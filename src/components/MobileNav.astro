---
import { navigation } from '../data/navigation';
---

<nav class="mobile-nav" data-mobile-nav aria-label="Mobile navigation">
  <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav-panel" data-menu-button>
    <span class="menu-label">Menu</span><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>
  <div class="mobile-nav-panel" id="mobile-nav-panel" data-menu-panel hidden>
    <div class="mobile-nav-panel-inner">
      <p class="mobile-nav-kicker">DragonSword Guide</p>
      <div class="mobile-nav-links">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-mobile-nav]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const button = root.querySelector('[data-menu-button]');
    const panel = root.querySelector('[data-menu-panel]');
    const links = [...root.querySelectorAll('a')];
    if (!button || !panel) return;

    const setOpen = (open) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open) links[0]?.focus();
      else button.focus();
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
    links.forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (button.getAttribute('aria-expanded') === 'true' && !root.contains(event.target)) setOpen(false);
    });
  })();
</script>

<style>
  .mobile-nav { display: none; position: relative; }
  .menu-button { display: inline-flex; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; gap: 0.55rem; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; background: var(--paper); font: inherit; font-size: 0.78rem; font-weight: 800; cursor: pointer; }
  .menu-button:hover { border-color: var(--accent); }
  .menu-icon { display: grid; gap: 3px; width: 16px; }
  .menu-icon i { display: block; height: 2px; background: var(--accent-light); }
  .mobile-nav-panel { position: absolute; top: calc(100% + 0.7rem); right: 0; width: min(20rem, calc(100vw - 2rem)); padding: 0.7rem; border: 1px solid var(--line); border-radius: 12px; background: hsl(221 27% 12% / 0.98); box-shadow: 0 18px 40px hsl(222 32% 3% / 0.45); }
  .mobile-nav-panel-inner { padding: 0.25rem; }
  .mobile-nav-kicker { margin: 0.35rem 0.7rem 0.55rem; color: var(--muted); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .mobile-nav-links { display: grid; }
  .mobile-nav-links a { display: flex; min-height: 44px; align-items: center; padding: 0.6rem 0.7rem; color: var(--ink); border-radius: 7px; font-size: 0.95rem; font-weight: 750; text-decoration: none; }
  .mobile-nav-links a:hover, .mobile-nav-links a:focus-visible { color: var(--accent-light); background: var(--raised); }
  @media (max-width: 900px) { .mobile-nav { display: block; } }
</style>
