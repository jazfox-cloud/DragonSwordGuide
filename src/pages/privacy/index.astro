---
import BaseLayout from '../../layouts/BaseLayout.astro'; const title='Privacy | DragonSword Guide'; const description='Privacy information for DragonSword Guide.'; const canonical='https://dragonswordguide.com/privacy/';
---
<BaseLayout title={title} description={description} canonical={canonical}><div class="shell legal"><h1>Privacy</h1><p>DragonSword Guide is an independent fan-made guide site. This page is a concise placeholder for the site’s privacy policy while the site is not configured with GA4 or other analytics.</p><p>External links may take you to Steam, YouTube, Discord or other third-party services. Their privacy policies apply when you leave this site.</p></div></BaseLayout>
<style>.legal{padding:4rem 0;max-width:720px}.legal h1{font-size:clamp(2.4rem,7vw,5rem);letter-spacing:-.05em}.legal p{color:var(--muted-strong)}</style>
