---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found | DragonSword Guide';
const description = 'The requested DragonSword Guide page could not be found.';
const canonical = 'https://dragonswordguide.com/404.html';
---

<BaseLayout title={title} description={description} canonical={canonical} noindex>
  <div class="shell error-wrap">
    <h1>Page not found</h1>
    <p>That DragonSword Guide page does not exist.</p>
    <p><a href="/">Return to DragonSword Guide</a></p>
  </div>
</BaseLayout>

<style>
  .error-wrap { padding: 4rem 0 5rem; }
  h1 { line-height: 1.2; letter-spacing: -0.025em; font-size: clamp(2rem, 7vw, 3rem); margin: 0 0 0.75rem; }
  p { color: var(--muted); }
</style>
