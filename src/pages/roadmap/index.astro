---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import LastVerified from '../../components/LastVerified.astro'; import UpdateBadge from '../../components/UpdateBadge.astro'; import SourceList from '../../components/SourceList.astro'; import { sourceUrls } from '../../data/sources';
const title='DragonSword Awakening Roadmap — Official Updates & Current Status'; const description='DragonSword Awakening roadmap tracker covering official post-launch plans, current update notes, multiplayer improvements, content updates and platform status.'; const canonical='https://dragonswordguide.com/roadmap/'; const article={ '@context':'https://schema.org','@type':'Article',headline:title,description,mainEntityOfPage:canonical,datePublished:'2026-08-08',dateModified:'2026-08-08',publisher:{'@type':'Organization',name:'DragonSword Guide'} }; const sources=[{label:'Official post-launch roadmap & Q&A',href:sourceUrls.roadmap,note:'primary roadmap source for post-launch plans and platform questions.'},{label:'Official Steam announcements',href:sourceUrls.announcements,note:'current update timeline, including the applied 1.0.7 notes.'}];
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="article" schema={[article]}><div class="shell page-wrap"><Breadcrumbs items={[{label:'DragonSword Guide',href:'/'},{label:'Roadmap'}]}/><article><header class="article-header"><p class="eyebrow">Updates · Source timeline</p><h1>DragonSword Awakening Roadmap</h1><LastVerified date="August 8, 2026"/></header><div class="roadmap-hero"><UpdateBadge label="Official source first" href={sourceUrls.roadmap}/><h2>Follow the official trail, not rumor.</h2><p>This page records what the public roadmap and Steam announcements support. It does not turn a community expectation into a scheduled release.</p></div><div class="timeline"><div><span class="date">Launch</span><h2>July 22, 2026</h2><p>Steam lists the full release and the base game’s current feature set.</p></div><div><span class="date">Current update</span><h2>1.0.7 applied</h2><p>Quick Entry, lobby search range, map pin capacity and Rune improvements are in the official notes.</p></div><div><span class="date">Next check</span><h2>Official announcements</h2><p>Use the official roadmap and announcements for dates. Unscheduled items remain open until Hound13 publishes a new notice.</p></div></div><SourceList sources={sources}/></article></div></BaseLayout>
<style>.page-wrap{padding:1.25rem 0 2rem}.article-header{max-width:820px;margin-bottom:1.5rem}.eyebrow{color:var(--accent-light);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}h1,h2{line-height:1.1;letter-spacing:-.04em}h1{font-size:clamp(2.4rem,7vw,5rem);margin:0 0 .7rem}h2{font-size:clamp(1.45rem,3vw,2rem);margin:.8rem 0 .45rem}.roadmap-hero{padding:1.5rem;background:linear-gradient(115deg,var(--accent-soft),var(--paper));border:1px solid hsl(199 86% 58% / .35);border-radius:14px}.roadmap-hero p{max-width:60ch;color:var(--muted-strong)}.timeline{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:2.5rem 0}.timeline>div{border-top:1px solid var(--accent);padding-top:1rem}.timeline h2{margin:.35rem 0;font-size:1.3rem}.timeline p{color:var(--muted);font-size:.85rem}.date{color:var(--accent-light);font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}@media(max-width:700px){.timeline{grid-template-columns:1fr}}</style>
