---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import LastVerified from '../../components/LastVerified.astro'; import UpdateBadge from '../../components/UpdateBadge.astro'; import SourceList from '../../components/SourceList.astro'; import { sourceUrls, patch107, patch108 } from '../../data/sources';
const title='DragonSword Awakening Roadmap — Official Updates & Current Status'; const description='DragonSword Awakening roadmap tracker covering official post-launch plans, current update notes, multiplayer improvements, content updates and platform status.'; const canonical='https://dragonswordguide.com/roadmap/'; const article={ '@context':'https://schema.org','@type':'Article',headline:title,description,mainEntityOfPage:canonical,datePublished:'2026-08-08',dateModified:'2026-08-10',publisher:{'@type':'Organization',name:'DragonSword Guide'} }; const sources=[{label:'Official post-launch roadmap & Q&A',href:sourceUrls.roadmap,note:'Evidence B — primary roadmap source for post-launch plans, heroes, Rifts, multiplayer Raids and platform status.'},{label:'Official Steam announcements',href:sourceUrls.announcements,note:'Evidence B — current update timeline; 1.0.8 was applied August 6, 2026 and 1.0.7 is retained as history.'},{label:'Official Aug 10 livestream announcement',href:sourceUrls.livestream,note:'Evidence B — announces the scheduled roadmap/AMA livestream; it does not establish livestream outcomes before publication.'}];
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="article" schema={[article]}><div class="shell page-wrap"><Breadcrumbs items={[{label:'DragonSword Guide',href:'/'},{label:'Roadmap'}]}/><article><header class="article-header"><p class="eyebrow">Updates · Source timeline</p><h1>DragonSword Awakening Roadmap</h1><LastVerified date="August 10, 2026"/></header><div class="roadmap-hero"><UpdateBadge label={`${patch108.label} · ${patch108.date}`} href={patch108.href}/><h2>Follow the official trail, not rumor.</h2><p>This page records what the public roadmap and Steam announcements support. It does not turn a community expectation into a scheduled release.</p></div><div class="timeline"><div><span class="date">Launch</span><h2>July 22, 2026</h2><p>Steam lists the full release and the base game’s current feature set.</p></div><div><span class="date">Current update</span><h2>1.0.8 applied</h2><p>1.0.8 is the latest official update, with four fixes for character states affected by holding the dodge key to dash. <a href={patch107.href}>1.0.7 remains in history</a> with its Quick Entry, matching-range, map-pin and Rune changes.</p></div><div><span class="date">August 10 check</span><h2>Roadmap livestream scheduled</h2><p>Hound13 announced an Aug 10 KST livestream with a detailed update-roadmap reveal, AMA and developer playthrough. The broadcast schedule is confirmed; its future announcements are not treated as facts until published.</p></div></div><section class="roadmap-details"><h2>What the post-launch roadmap confirms</h2><ul><li>Four additional Heroes are planned for the second half of 2026: Ryza, Jerome, Veronica and Logan.</li><li>Post-launch direction includes quality-of-life work, Hero Quests, the Rift system and multiplayer Raids.</li><li>These are roadmap plans, not confirmed release dates. The roadmap does not establish a current console launch date, cross-platform play or story/open-world co-op.</li></ul><p class="evidence-note"><strong>Evidence B boundary:</strong> the roadmap and official Steam announcements are primary sources. Community pages may help identify questions, but they do not upgrade a feature, date, platform or character claim.</p></section><SourceList sources={sources}/></article></div></BaseLayout>
<style>.page-wrap{padding:1.25rem 0 2rem}.article-header{max-width:820px;margin-bottom:1.5rem}.eyebrow{color:var(--accent-light);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}h1,h2{line-height:1.1;letter-spacing:-.04em}h1{font-size:clamp(2.4rem,7vw,5rem);margin:0 0 .7rem}h2{font-size:clamp(1.45rem,3vw,2rem);margin:.8rem 0 .45rem}.roadmap-hero{padding:1.5rem;background:linear-gradient(115deg,var(--accent-soft),var(--paper));border:1px solid hsl(199 86% 58% / .35);border-radius:14px}.roadmap-hero p{max-width:60ch;color:var(--muted-strong)}.timeline{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:2.5rem 0}.timeline>div{border-top:1px solid var(--accent);padding-top:1rem}.timeline h2{margin:.35rem 0;font-size:1.3rem}.timeline p{color:var(--muted);font-size:.85rem}.date{color:var(--accent-light);font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}@media(max-width:700px){.timeline{grid-template-columns:1fr}}</style>
