---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LastVerified from '../../components/LastVerified.astro';
import SourceList from '../../components/SourceList.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import AdsterraNativeBanner from '../../components/AdsterraNativeBanner.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import InteractiveMap from '../../components/InteractiveMap.astro';
import markerData from '../../data/map-markers.json';
import chestManifest from '../../../public/data/map/chests/manifest.json';
import { sourceUrls, patch107 } from '../../data/sources';

const title = 'DragonSword Awakening Interactive Map — Orbis Beta';
const description = 'Search and filter the DragonSword Awakening Interactive Map beta for approximate Orbis Eona, Organa, Warp Point, Dungeon, Field Boss and Treasure Chest markers with clear verification labels.';
const canonical = 'https://dragonswordguide.com/map/';
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  mainEntityOfPage: canonical,
  datePublished: '2026-08-08',
  dateModified: '2026-08-23',
  publisher: { '@type': 'Organization', name: 'DragonSword Guide' },
};
const sources = [
  { label: 'Official Steam store page', href: sourceUrls.steam, note: 'Evidence B — confirms Orbis, meadows, watchtower cellars, deep seas, caves and dungeons.' },
  { label: 'Official 1.0.7 update notes', href: patch107.href, note: 'Evidence B — increased saved World Map pins from 100 to 200.' },
  { label: 'Steam global achievements', href: 'https://steamcommunity.com/stats/4570720/achievements', note: 'Evidence B — confirms Fast Travel Expert for activating all Waypoints.' },
  { label: 'Waypoint and fast travel guide', href: 'https://www.dragonsword-awakening.wiki/guides/guide/map-waypoints-fast-travel', note: 'Evidence C — explains Waypoints as fast-travel progression objects without exact coordinates.' },
  { label: 'Public Orbis map data layer', href: 'https://dragonswordawakening.net/map', note: 'Evidence C — reports 20 Warp Points; used for count/category corroboration, not copied coordinates.' },
  { label: 'GrandWiki Orbis map', href: 'https://dsawakening.grandwiki.com/map', note: 'Evidence C — public technical model exposes 20 waypoint-category markers named Warp Point.' },
  { label: 'Dungeon database', href: 'https://dragonswordawakening.net/database/dungeons', note: 'Evidence C — lists playable dungeon activity records; activity existence does not prove exact entrance placement.' },
  { label: 'Dungeon guide', href: 'https://dragonswordawakening.net/guides/dungeons', note: 'Evidence C — corroborates dungeon taxonomy and selected named dungeon records.' },
  { label: 'Public Orbis map layer', href: 'https://dragonsword-awakening.org/maps?type=TOWN', note: 'Evidence C — public map layer lists dungeon entrances; coordinates and map assets were not copied.' },
  { label: 'Dungeon taxonomy index', href: 'https://dragonsword-awakening.org/dungeons?page=%223%22', note: 'Evidence C — broader dungeon taxonomy used for candidate counting, not for exact placement claims.' },
  { label: 'Story dungeon quest guide', href: 'https://gcz.gg/en/games/dragon-sword-awakening/quests/where-the-giant-sleeps', note: 'Evidence C — confirms a Dungeon entrance step for Where the Giant Sleeps on the Orbis world map; no exact coordinates used.' },
  { label: 'Altar of the Dragon quest guide', href: 'https://gcz.gg/en/games/dragon-sword-awakening/quests/ornette-s-request', note: 'Evidence C — confirms an Enter Dungeon step for Altar of the Dragon on the Orbis world map; no exact coordinates used.' },
  { label: 'Dragon Disciple hideout walkthrough', href: 'https://intoindiegames.com/walkthroughs/dragonsword-awakening-walkthrough-part-2-chapter-1/', note: 'Evidence C — describes reaching the Dragon Disciple hideout entrance and heading inside; used only for location eligibility.' },
  { label: 'Tomb of Greed access discussion', href: 'https://steamcommunity.com/app/4570720/discussions/0/581678051258051230/', note: 'Evidence C — public player discussion treats Tomb of Greed as a dungeon/location access question; no coordinates copied.' },
  { label: 'Field Boss map-icon guide', href: 'https://dragonswordawakening.net/guides/exploration-and-map-icons', note: 'Evidence C — reports 9 Field Bosses as a separate public map layer from dungeons.' },
  { label: 'Public Field Boss map labels', href: 'https://dragonsword-awakening.org/maps?type=TOWN', note: 'Evidence C — public map labels list 9 Field Boss names and nearby regions; coordinates and map assets were not copied.' },
  { label: 'GrandWiki Orbis Field Boss layer', href: 'https://dsawakening.grandwiki.com/map', note: 'Evidence C — public map guide says field bosses use current in-game names for location questions and exposes a field-boss layer.' },
  { label: 'World boss name guide', href: 'https://dragonsword-awakening.wiki/guides/guide/world-boss-rewards-1-0-4', note: 'Evidence C — corroborates the world-boss name pool and explicitly does not provide exact map coordinates.' },
  { label: 'Public chest map layer', href: 'https://dragonswordawakening.net/map', note: 'Evidence C — used as one public position source for full-scale Chest position corroboration; exact source coordinates were not republished as-is.' },
  { label: 'Dragonsword Companion public map', href: 'https://www.dragonswordc.com/', note: 'Evidence C — used as an independent public position comparison source for the full-scale Chest layer.' },
  { label: 'GrandWiki Orbis map', href: 'https://dsawakening.grandwiki.com/map', note: 'Evidence C — confirms dense chest-layer map behavior and grouped search; not used as a copied chest coordinate table.' },
  { label: 'Steam global achievements', href: 'https://steamcommunity.com/stats/4570720/achievements', note: 'Evidence B — confirms Treasure Chest gameplay through the Anything in Here? achievement, not exact locations.' },
  { label: 'Community interactive-map discussion', href: 'https://www.reddit.com/r/DSwordAwakening/comments/1vap7qr/all_chests_locations_interactive_map/', note: 'Evidence C — demand and discovery signal only; not copied marker coordinates or a complete map claim.' },
];
const totalMapMarkers = markerData.markers.length + chestManifest.total_published;
---

<BaseLayout title={title} description={description} canonical={canonical} routeId="map" ogType="article" schema={[article]}>
  <div class="shell page-wrap">
    <Breadcrumbs items={[{ label: 'DragonSword Guide', href: '/' }, { label: 'Map' }]} />
    <article>
      <header class="article-header">
        <p class="eyebrow">Map · Interactive beta</p>
        <h1>DragonSword Awakening Interactive Map</h1>
        <LastVerified date="August 23, 2026" />
      </header>

      <QuickAnswer title="Use this beta map for broad Orbis planning, not exact collectible routing.">
        <p>The current DragonSword Awakening Interactive Map uses an owned schematic Orbis base map and normalized relative coordinates. Eona, Organa, Warp Point, Dungeon, Field Boss and Treasure Chest markers are source-corroborated but still approximate; none is presented as an official, video or first-hand verified in-game pin.</p>
      </QuickAnswer>

      <InteractiveMap markerData={markerData} chestMarkerCount={chestManifest.total_published} />

      <div class="copy">
        <h2>How to use the map</h2>
        <p>Drag the schematic to pan, use the zoom controls to inspect a region, search by marker name, region, subtype or alias, and turn Eona's Legacy, Organa Statue, Warp Point, Dungeon, Boss or Treasure Chest categories on and off. Treasure Chests are off by default and load as a separate clustered layer with region filtering.</p>

        <h2>What is mapped now</h2>
        <p>This MVP publishes a beta set for Eona's Legacy, named Organa Statue markers, 20 Warp Point planning anchors, 26 Dungeon entrance planning markers, 9 open-world Field Boss planning markers and 1,484 Treasure Chest planning markers across 20 schematic regions. The Eona pilot remains unchanged. Organa coverage is 13 published markers against a 13-14 public-source range; the 13 vs 14 count conflict remains retained because the apparent 14th map-layer entry is not yet named as a separate restoration statue. Warp Point coverage is 20 published / 20 known. Dungeon coverage is 26 published / 26 mapped entrances. Boss coverage is 9 published / 9 mapped Field Bosses. Chest coverage is full-scale published for strong and moderate public position agreement; weak or conflicting positions remain unpublished.</p>

        <AdsterraNativeBanner />

        <h2>Verification status</h2>
        <p>Marker coordinates are <strong>IMAGE_RELATIVE_COORDINATES</strong> on <strong>OWN_SCHEMATIC_ORBIS_BASE_MAP</strong>. The live dataset contains {totalMapMarkers} approximate beta markers and 0 official, video or first-hand verified markers. The Chest layer uses <strong>MULTI_SOURCE_PUBLIC_POSITION_CORROBORATION</strong> with <strong>LANDMARK_APPROXIMATE</strong> precision; it does not claim exact in-game coordinates, respawn rules or first-hand verification.</p>

        <h2>Updates and data provenance</h2>
        <p>The official 1.0.7 note confirms World Map pin capacity changed from 100 to 200, which supports map-planning demand but does not provide marker locations. Dungeon sources are split between activity records and public entrance-layer evidence, so a dungeon name alone is not treated as a publishable location. Boss sources are split the same way: name-pool evidence alone is not enough, and only location-level open-world Field Boss candidates are published. Chest sources went through a full-scale public-coordinate gate before the 1,484-marker layer was exported; conflicting, weak or single-source chest positions remain unpublished.</p>
      </div>

      <SourceList sources={sources} />
      <RelatedGuides links={[{ label: 'Beginner Guide', href: '/guides/beginner/' }, { label: 'Characters', href: '/characters/' }, { label: 'Gameplay', href: '/gameplay/' }, { label: 'Roadmap', href: '/roadmap/' }]} />
    </article>
  </div>
</BaseLayout>

<style>
  .page-wrap { padding: 1.25rem 0 2rem; }
  .article-header { max-width: 860px; margin-bottom: 1.5rem; }
  .eyebrow { color: var(--accent-light); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1, h2 { line-height: 1.1; letter-spacing: 0; }
  h1 { font-size: clamp(2.4rem, 7vw, 5rem); margin: 0 0 0.7rem; }
  h2 { font-size: clamp(1.45rem, 3vw, 2rem); margin: 2.5rem 0 0.7rem; }
  .copy { max-width: 820px; }
  .copy p { color: var(--muted-strong); }
  .copy strong { overflow-wrap: anywhere; }
</style>
