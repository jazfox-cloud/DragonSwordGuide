---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LastVerified from '../../components/LastVerified.astro';
import SourceList from '../../components/SourceList.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import AdsterraNativeBanner from '../../components/AdsterraNativeBanner.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import InteractiveMap from '../../components/InteractiveMap.astro';
import markerData from '../../data/map-markers.json';
import { sourceUrls, patch107 } from '../../data/sources';

const title = 'DragonSword Awakening Interactive Map — Orbis Beta';
const description = 'Search and filter the DragonSword Awakening Interactive Map beta for approximate Orbis Eona and Organa markers with clear verification labels.';
const canonical = 'https://dragonswordguide.com/map/';
const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  mainEntityOfPage: canonical,
  datePublished: '2026-08-08',
  dateModified: '2026-08-22',
  publisher: { '@type': 'Organization', name: 'DragonSword Guide' },
};
const sources = [
  { label: 'Official Steam store page', href: sourceUrls.steam, note: 'Evidence B — confirms Orbis, meadows, watchtower cellars, deep seas, caves and dungeons.' },
  { label: 'Official 1.0.7 update notes', href: patch107.href, note: 'Evidence B — increased saved World Map pins from 100 to 200.' },
  { label: 'Community interactive-map discussion', href: 'https://www.reddit.com/r/DSwordAwakening/comments/1vap7qr/all_chests_locations_interactive_map/', note: 'Evidence C — demand and discovery signal only; not copied marker coordinates or a complete map claim.' },
];
---

<BaseLayout title={title} description={description} canonical={canonical} ogType="article" schema={[article]}>
  <div class="shell page-wrap">
    <Breadcrumbs items={[{ label: 'DragonSword Guide', href: '/' }, { label: 'Map' }]} />
    <article>
      <header class="article-header">
        <p class="eyebrow">Map · Interactive beta</p>
        <h1>DragonSword Awakening Interactive Map</h1>
        <LastVerified date="August 22, 2026" />
      </header>

      <QuickAnswer title="Use this beta map for broad Orbis planning, not exact collectible routing.">
        <p>The current DragonSword Awakening Interactive Map uses an owned schematic Orbis base map and normalized relative coordinates. The first Eona pilot markers are source-corroborated but still approximate; none is presented as an official or first-hand verified in-game pin.</p>
      </QuickAnswer>

      <InteractiveMap markerData={markerData} />

      <div class="copy">
        <h2>How to use the map</h2>
        <p>Drag the schematic to pan, use the zoom controls to inspect a region, search by marker name or region, and turn Eona's Legacy or Organa Statue categories on and off. Select any marker to read its precision, confidence and evidence boundary.</p>

        <h2>What is mapped now</h2>
        <p>This MVP publishes a small beta set for Eona's Legacy and Organa Statue candidates only. The Eona pilot now has named, source-corroborated records where the evidence is strong enough. The map still does not publish a chest database, exact route, full collectible count, respawn rule, copied community pin set or official map asset.</p>

        <AdsterraNativeBanner />

        <h2>Verification status</h2>
        <p>Marker coordinates are <strong>IMAGE_RELATIVE_COORDINATES</strong> on <strong>OWN_SCHEMATIC_ORBIS_BASE_MAP</strong>. The live dataset contains {markerData.markers.length} approximate beta markers and 0 official, video or first-hand verified markers. Specific routes will be upgraded only after first-hand screenshots, stable landmarks and reproducible path notes exist.</p>

        <h2>Updates and data provenance</h2>
        <p>The official 1.0.7 note confirms World Map pin capacity changed from 100 to 200, which supports map-planning demand but does not provide marker locations. Community map threads remain discovery inputs, not production coordinate sources.</p>
      </div>

      <SourceList sources={sources} />
      <RelatedGuides links={[{ label: 'Beginner Guide', href: '/guides/beginner/' }, { label: 'Characters', href: '/characters/' }, { label: 'Gameplay', href: '/gameplay/' }, { label: 'Roadmap', href: '/roadmap/' }]} />
    </article>
  </div>
</BaseLayout>

<style>
  .page-wrap { padding: 1.25rem 0 2rem; }
  .article-header { max-width: 860px; margin-bottom: 1.5rem; }
  .eyebrow { color: var(--accent-light); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1, h2 { line-height: 1.1; letter-spacing: 0; }
  h1 { font-size: clamp(2.4rem, 7vw, 5rem); margin: 0 0 0.7rem; }
  h2 { font-size: clamp(1.45rem, 3vw, 2rem); margin: 2.5rem 0 0.7rem; }
  .copy { max-width: 820px; }
  .copy p { color: var(--muted-strong); }
</style>
