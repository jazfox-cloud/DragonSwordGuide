---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import LastVerified from '../../components/LastVerified.astro'; import UpdateBadge from '../../components/UpdateBadge.astro'; import SourceList from '../../components/SourceList.astro'; import RelatedGuides from '../../components/RelatedGuides.astro'; import { sourceUrls, patch107 } from '../../data/sources';
const title='DragonSword Awakening Map & Locations — Orbis Reference'; const description='DragonSword Awakening map and locations hub for the Continent of Orbis, caves, dungeons, watchtower cellars, treasure, resources and current map pin limits.'; const canonical='https://dragonswordguide.com/map/'; const article={ '@context':'https://schema.org','@type':'Article',headline:title,description,mainEntityOfPage:canonical,datePublished:'2026-08-08',dateModified:'2026-08-13',publisher:{'@type':'Organization',name:'DragonSword Guide'} }; const sources=[{label:'Official Steam store page',href:sourceUrls.steam,note:'Evidence B — confirms Orbis, meadows, watchtower cellars, deep seas, caves and dungeons.'},{label:'Official 1.0.7 update notes',href:sourceUrls.announcements,note:'Evidence B — increased saved World Map pins from 100 to 200.'},{label:'Community interactive-map discussion',href:'https://www.reddit.com/r/DSwordAwakening/comments/1vap7qr/all_chests_locations_interactive_map/',note:'Evidence C — indicates demand for chest and interactive-map help; the post describes a work in progress, not an official complete map.'}];
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="article" schema={[article]}><div class="shell page-wrap"><Breadcrumbs items={[{label:'DragonSword Guide',href:'/'},{label:'Map'}]}/><article><header class="article-header"><p class="eyebrow">Map · Locations hub</p><h1>DragonSword Awakening Map & Locations</h1><LastVerified date="August 13, 2026"/></header><div class="map-panel"><span class="map-cross cross-one"></span><span class="map-cross cross-two"></span><div><UpdateBadge label={`${patch107.label} · Map pins 100 → 200`} href={patch107.href}/><h2>Orbis is the map we can verify today</h2><p>Use this hub to organize exploration notes without pretending we have an interactive coordinate map.</p></div></div><div class="copy"><h2>Continent of Orbis</h2><p>The official store page describes an anime-style open world with meadows, secret cellars beneath watchtowers, treasure-filled deep seas, hidden caves and dungeons.</p><h2>What to track</h2><div class="location-list"><span>Caves</span><span>Dungeons</span><span>Watchtower cellars</span><span>Treasure</span><span>Resources</span><span>Quests & NPCs</span></div><h2>Interactive map and chest locations</h2><p>Community players are actively looking for chest and interactive-map help, including a work-in-progress map shared on Reddit. That is <strong>Evidence C — Demand Signal</strong>, not proof that every chest or marker is confirmed. This page does not claim a complete chest index, exact chest count or verified coordinates.</p><h2>What future location guides need</h2><p>Specific location guides should be added only when first-hand screenshots, stable landmarks and a reproducible route are available. Until then, this parent page owns the broad map, locations and exploration intent.</p><h2>Interactive map in development</h2><p>We are not adding fake coordinate markers. A useful interactive map needs first-hand location data, route screenshots and a stable naming system.</p></div><SourceList sources={sources}/><RelatedGuides links={[{label:'Beginner Guide',href:'/guides/beginner/'},{label:'Characters',href:'/characters/'},{label:'Gameplay',href:'/gameplay/'},{label:'Home',href:'/'}]}/></article></div></BaseLayout>
<style>.page-wrap{padding:1.25rem 0 2rem}.article-header{max-width:820px;margin-bottom:1.5rem}.eyebrow{color:var(--accent-light);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}h1,h2{line-height:1.1;letter-spacing:-.04em}h1{font-size:clamp(2.4rem,7vw,5rem);margin:0 0 .7rem}h2{font-size:clamp(1.45rem,3vw,2rem);margin:2.5rem 0 .7rem}.map-panel{position:relative;min-height:280px;display:flex;align-items:end;overflow:hidden;padding:1.5rem;border:1px solid hsl(199 86% 58% / .45);border-radius:18px 5px 18px 5px;background:radial-gradient(circle at 70% 30%,hsl(192 92% 68% / .2),transparent 20%),linear-gradient(145deg,hsl(202 65% 20% / .75),var(--paper) 70%)}.map-panel h2{max-width:14ch;margin:.8rem 0 .3rem}.map-panel p{max-width:48ch;color:var(--muted-strong);margin:0}.map-cross{position:absolute;width:180px;height:180px;border:1px solid hsl(192 92% 68% / .2);border-radius:50%;right:10%;top:12%}.cross-two{width:280px;height:280px;right:-2%;top:-6%}.copy{max-width:760px}.copy p{color:var(--muted-strong)}.location-list{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}.location-list span{padding:.85rem;border-bottom:1px solid var(--accent);background:var(--paper);font-size:.86rem}@media(max-width:650px){.location-list{grid-template-columns:1fr 1fr}}</style>
