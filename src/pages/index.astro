---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatChip from '../components/StatChip.astro';
import CharacterCard from '../components/CharacterCard.astro';
import CTASection from '../components/CTASection.astro';
import UpdateBadge from '../components/UpdateBadge.astro';
import AdsterraNativeBanner from '../components/AdsterraNativeBanner.astro';
import OfficialMedia from '../components/OfficialMedia.astro';
import { previewCharacters } from '../data/characters';
import { sourceUrls, latestAppliedPatch } from '../data/sources';

const title = 'DragonSword Awakening Wiki — Builds, Map & Characters';
const description = 'DragonSword Awakening fan guide covering builds, characters, maps, co-op, Karma, current game updates, and beginner walkthroughs with verified sources.';
const canonical = 'https://dragonswordguide.com/';
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'DragonSword Guide', url: canonical, description, dateModified: '2026-08-26' };
const organization = { '@context': 'https://schema.org', '@type': 'Organization', name: 'DragonSword Guide', url: canonical, description: 'Independent fan-made DragonSword: Awakening guide and reference site.' };
---

<BaseLayout title={title} description={description} canonical={canonical} routeId="home" schema={[website, organization]}>
  <div class="home-page">
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">DragonSword : Awakening · Unofficial fan-made guide</p>
        <h1>DragonSword Awakening Guides</h1>
        <p class="hero-lede">A clear field guide to the anime-style open-world action RPG set across the Continent of Orbis. Learn the 19-Hero tag combat loop, track progression systems, and find the answers that are actually supported by public sources.</p>
        <div class="hero-actions"><a class="button primary" href="/guides/beginner/">Start Beginner Guide</a><a class="button secondary" href="/guides/combat-system/">Signal Skills Guide</a><a class="text-link" href="/characters/">Explore Characters <span aria-hidden="true">↗</span></a><a class="text-link" href="/multiplayer/">Multiplayer Guide <span aria-hidden="true">↗</span></a></div>
        <div class="stats" aria-label="Game facts"><StatChip value="Jul 22, 2026" label="Launch date" /><StatChip value="$29.99" label="Base price on Steam" /><StatChip value="19" label="Playable Heroes" /><StatChip value="Online" label="Co-op listed" /></div>
      </div>
      <OfficialMedia />
    </section>

    <section class="home-section shell signal-section">
      <div class="signal-heading"><SectionHeader eyebrow="Live signal" title="What is changing now" description="Official update notes are the fastest way to separate a current system from launch-era assumptions." /><UpdateBadge label={`${latestAppliedPatch.label} · ${latestAppliedPatch.date}`} href={latestAppliedPatch.href} /></div>
      <div class="signal-list"><a href="/roadmap/"><strong>1.0.10 is applied</strong><span>The latest official update improves inventory, item-info and team-setting flows, adds hero acquisition cinematics, and fixes multiplayer and Treasure Map issues.</span></a><a href="/multiplayer/"><strong>Quick Entry is live</strong><span>1.0.7 added Quick Entry and a lobby search range setting for multiplayer matching.</span></a><a href="/systems/runes/"><strong>Rune capacity is 500</strong><span>1.0.7 increased Rune inventory capacity from 200 to 500 and enabled 4-Star synthesis to yield 5-Star Runes.</span></a></div>
    </section>

    <section class="home-section shell"><SectionHeader eyebrow="Start here" title="A practical first route through Orbis" description="Use the page that matches the question in front of you. Each guide keeps official facts separate from reports still waiting for first-hand verification." /><div class="guide-grid four"><GuideCard href="/guides/beginner/" eyebrow="First hours" title="Beginner Guide" description="First-hours progression, combat basics, early resources, exploration and team setup." /><GuideCard href="/system-requirements/" eyebrow="PC setup" title="System Requirements" description="Official minimum and recommended Windows specs, storage and SSD notes." accent="cool" /><GuideCard href="/map/" eyebrow="World reference" title="Map & Locations" description="Orbis regions, caves, dungeons, resources and exploration references." accent="deep" /><GuideCard href="/guides/combat-system/" eyebrow="Combat guide" title="Signal Skills & Status Effects" description="Trigger Signal Skills, match status conditions, and diagnose missing prompts." accent="silver" /></div></section>

    <section class="home-section shell systems-section"><SectionHeader eyebrow="The system map" title="The parts that make a team work" /><div class="system-rail"><span>19 Heroes</span><span>Three-Hero Teams</span><span>Status Ailments</span><span>Signal Skills</span><span>Familiars</span><span>Cooking</span><span>Online Co-op</span><span>Open World</span></div></section>

    <section class="home-section shell"><SectionHeader eyebrow="Popular guides" title="Choose your next read" /><div class="guide-grid popular"><GuideCard href="/guides/beginner/" title="Beginner Guide" description="A calmer first session checklist." /><GuideCard href="/multiplayer/" title="Multiplayer" description="Co-op activities, lobbies and 1.0.7 matching changes." /><GuideCard href="/guides/combat-system/" title="Signal Skills Guide" description="Status conditions, trigger checks and missing-prompt fixes." /><GuideCard href="/characters/" title="Characters" description="A cautious 19-Hero directory." /><GuideCard href="/map/" title="Map" description="What the official game page confirms about Orbis." /><GuideCard href="/systems/runes/" title="Runes" description="Capacity and synthesis changes, verified." /><GuideCard href="/is-it-gacha/" title="Is It Gacha?" description="Premium purchase and acquisition facts." /><GuideCard href="/gameplay/" title="Gameplay" description="Exploration, combat, cooking and companions." /></div></section>

    <section class="home-section shell"><AdsterraNativeBanner /></section>

    <section class="home-section shell character-section"><div class="section-split"><SectionHeader eyebrow="Roster preview" title="Characters, with the uncertainty visible" description="The game confirms 19 Heroes and several official story or update mentions. Exact traits, factions, unlock routes and combat roles still need first-hand testing." /><a class="text-link" href="/characters/">See all 19 names <span aria-hidden="true">↗</span></a></div><div class="character-grid">{previewCharacters.map((character) => <CharacterCard {...character} />)}</div></section>

    <section class="home-section shell roadmap-strip"><div><UpdateBadge label="Official update trail · verified August 26" href={sourceUrls.roadmap} /><h2>Roadmap, announcements, and the build in front of you</h2><p>We track public update notes and mark the date each page was last checked. If a system is not verified, the page says so.</p></div><a class="button secondary" href="/roadmap/">Open roadmap</a></section>

    <section class="home-section shell trust-section"><SectionHeader eyebrow="How we work" title="Evidence before wiki confidence" /><div class="trust-grid"><div><strong>Official sources first</strong><p>Steam, Hound13 announcements, the official roadmap and official video channels lead the research.</p></div><div><strong>Community claims stay labeled</strong><p>Player reports can point to a question, but they do not become official fact by repetition.</p></div><div><strong>No guessed stats</strong><p>Missing data is marked “Not yet verified” instead of filled with a plausible-looking number.</p></div></div></section>

    <section class="home-section shell"><CTASection title="Ready to master DragonSword Awakening?" primaryHref="/guides/beginner/" primaryLabel="Read the Beginner Guide" secondaryHref={sourceUrls.steam} secondaryLabel="Play on Steam" /></section>
  </div>
</BaseLayout>

<style>
  .home-page { overflow: hidden; }
  .hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr); gap: clamp(2rem, 7vw, 6rem); align-items: center; padding-top: clamp(4rem, 9vw, 7rem); padding-bottom: clamp(3rem, 7vw, 5rem); }
  .eyebrow { color: var(--accent-light); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 0.8rem; }
  h1 { max-width: 8ch; margin: 0; font-size: clamp(3.2rem, 9vw, 7.2rem); line-height: 0.92; letter-spacing: -0.065em; }
  .hero-lede { max-width: 62ch; color: var(--muted-strong); font-size: clamp(1rem, 2vw, 1.15rem); margin: 1.5rem 0 0; }
  .hero-actions { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; margin: 1.75rem 0 2.25rem; }
  .button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; border-radius: 8px; padding: 0.7rem 1rem; font-size: 0.82rem; font-weight: 800; text-decoration: none; }
  .primary { color: var(--wash); background: var(--accent); }
  .primary:hover { background: var(--accent-light); }
  .secondary { color: var(--ink); border: 1px solid var(--line); background: var(--paper); }
  .secondary:hover { border-color: var(--accent); }
  .text-link { color: var(--accent-light); font-size: 0.82rem; font-weight: 800; text-decoration: none; }
  .stats { display: flex; gap: 1.35rem; flex-wrap: wrap; }
  .home-section { margin-top: clamp(4rem, 8vw, 7rem); }
  .guide-grid { display: grid; gap: 0.8rem; }
  .guide-grid.four { grid-template-columns: repeat(4, 1fr); }
  .guide-grid.popular { grid-template-columns: repeat(4, 1fr); }
  .guide-grid.popular .guide-card { min-height: 150px; }
  .signal-section { padding: 1.5rem; background: hsl(221 27% 12% / 0.55); border-block: 1px solid var(--line); }
  .signal-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; }
  .signal-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  .signal-list a { display: grid; gap: 0.3rem; padding: 1rem; color: var(--ink); border-top: 1px solid var(--accent); text-decoration: none; }
  .signal-list a:hover { background: var(--raised); }
  .signal-list strong { font-size: 0.9rem; }
  .signal-list span { color: var(--muted); font-size: 0.82rem; }
  .systems-section { padding-block: 1.5rem; border-block: 1px solid var(--line); }
  .system-rail { display: flex; gap: 0; overflow-x: auto; padding-bottom: 0.4rem; }
  .system-rail span { flex: 1 0 auto; color: var(--muted-strong); border-left: 1px solid var(--accent); padding: 0.7rem 1rem; font-size: 0.82rem; }
  .section-split { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .character-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .roadmap-strip { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: 1.5rem; background: linear-gradient(105deg, var(--accent-soft), var(--paper)); border: 1px solid hsl(199 86% 58% / 0.28); border-radius: 14px; }
  .roadmap-strip h2 { max-width: 18ch; margin: 0.8rem 0 0.4rem; line-height: 1.05; letter-spacing: -0.04em; }
  .roadmap-strip p { color: var(--muted); max-width: 58ch; margin: 0; }
  .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .trust-grid > div { border-top: 1px solid var(--accent); padding-top: 0.8rem; }
  .trust-grid strong { font-size: 0.92rem; }
  .trust-grid p { color: var(--muted); font-size: 0.84rem; margin: 0.4rem 0 0; }
  @media (max-width: 980px) { .hero { grid-template-columns: 1fr 0.8fr; } .guide-grid.four, .guide-grid.popular { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 700px) { .hero { grid-template-columns: 1fr; padding-top: 3.5rem; } .signal-heading, .roadmap-strip, .section-split { display: grid; align-items: start; } .signal-list, .character-grid, .trust-grid { grid-template-columns: 1fr; } .guide-grid.four, .guide-grid.popular { grid-template-columns: 1fr; } .stats { gap: 1rem; } }
</style>
