---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LastVerified from '../../components/LastVerified.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import SourceList from '../../components/SourceList.astro';
import UpdateBadge from '../../components/UpdateBadge.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import AdsterraNativeBanner from '../../components/AdsterraNativeBanner.astro';
import { latestAppliedPatch, previousApplied } from '../../data/sources';

const title = 'Is DragonSword Awakening Multiplayer? Co-op Explained';
const description = "Yes, DragonSword: Awakening supports online co-op for selected activities. See what's officially confirmed for Subjugation, Raids, story co-op, lobbies, and matchmaking.";
const canonical = 'https://dragonswordguide.com/multiplayer/';
const verifiedDate = 'September 4, 2026';
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dragonswordguide.com/' }, { '@type': 'ListItem', position: 2, name: 'Multiplayer', item: canonical }] };
const article = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, mainEntityOfPage: canonical, datePublished: '2026-08-08', dateModified: '2026-09-04', publisher: { '@type': 'Organization', name: 'DragonSword Guide' } };
const sources = [
  { label: 'Official Steam store page', href: 'https://store.steampowered.com/app/4570720/DragonSword__Awakening/', note: 'OFFICIAL_VERIFIED: lists Single-player and Online Co-op.' },
  { label: 'Official Steam update notes 1.0.7', href: 'https://steamcommunity.com/app/4570720/announcements/', note: 'OFFICIAL_VERIFIED: confirms Quick Entry and a lobby search range setting for multiplayer matching.' },
  { label: 'Official update notes 1.0.11', href: latestAppliedPatch.href, note: 'OFFICIAL_VERIFIED: confirms Retry, fastest-response lobby search, version notices, departure notifications and lobby fixes.' },
  { label: 'Official update notes 1.0.10', href: previousApplied.href, note: 'OFFICIAL_VERIFIED: multiplayer lobbies disband the party when the party leader is unresponsive for a long time.' },
  { label: 'Hound13 developer discussion', href: 'https://steamcommunity.com/app/4570720/discussions/0/802344445710375983/', note: 'OFFICIAL_VERIFIED developer source: describes Subjugation and Raids, and says story co-op was not ready for launch.' },
];
---
<BaseLayout title={title} description={description} canonical={canonical} routeId="multiplayer" ogType="article" schema={[article, breadcrumb]}>
  <div class="shell page-wrap">
    <Breadcrumbs items={[{ label: 'DragonSword Guide', href: '/' }, { label: 'Multiplayer' }]} />
    <article>
      <header class="article-header">
        <p class="eyebrow">Guide · Current multiplayer systems</p>
        <h1>Is DragonSword Awakening Multiplayer?</h1>
        <LastVerified date={verifiedDate} />
      </header>

      <UpdateBadge label={`${latestAppliedPatch.label} · ${latestAppliedPatch.date}`} href={latestAppliedPatch.href} />

      <QuickAnswer title="Yes — selected activities support online co-op.">
        <p>Steam lists Single-player and Online Co-op. Update 1.0.11 adds Hunt/Raid Retry for the party leader after a final clear or party wipe, searches lobbies by fastest response time, and adds version notices for Quick Entry and invite-code joins. The 1.0.10 rule for an unresponsive party leader remains historical applied behavior. Exact player count, unlock requirements, crossplay, the complete invite flow, shared progression and loot rules are not yet verified here.</p>
      </QuickAnswer>

      <div class="article-body">
        <SectionHeader eyebrow="Current status" title="What is confirmed now" description="Known multiplayer facts appear first; mechanics that still need official or first-hand evidence stay marked as not verified." />

        <div class="status-grid" aria-label="Confirmed multiplayer status">
          <div><strong>Online co-op</strong><span>Confirmed on Steam</span></div>
          <div><strong>Subjugation & Raids</strong><span>Confirmed by Hound13</span></div>
          <div><strong>Quick Entry</strong><span>Added in official 1.0.7</span></div>
          <div><strong>Retry</strong><span>Hunt / Raid · official 1.0.11</span></div>
          <div><strong>Lobby matching</strong><span>Fastest response · official 1.0.11</span></div>
          <div><strong>Unresponsive party leader</strong><span>Party disbands · official 1.0.10</span></div>
        </div>

        <h2>How Does Multiplayer Work in DragonSword: Awakening?</h2>
        <p>DragonSword: Awakening is built first as a single-player RPG with selected online co-op content. Steam confirms the Online Co-op label, Hound13 identifies Subjugation and Raids as co-op activities, and the official update trail confirms Quick Entry, Hunt/Raid Retry and current fastest-response lobby search.</p>
        <p>For the broader game loop around those activities, compare the <a href="/gameplay/">gameplay systems</a> overview and the <a href="/teams/">team-building guide</a>. Those pages explain combat and team structure; this page remains the owner for multiplayer and co-op status.</p>

        <div class="table-wrap mechanism-table">
          <table>
            <thead>
              <tr>
                <th scope="col">Multiplayer feature</th>
                <th scope="col">Current status</th>
                <th scope="col">Evidence</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Multiplayer / co-op exists</th>
                <td>Verified</td>
                <td>Steam lists Online Co-op.</td>
              </tr>
              <tr>
                <th scope="row">Subjugation</th>
                <td>Verified co-op activity</td>
                <td>Hound13 developer discussion.</td>
              </tr>
              <tr>
                <th scope="row">Raids</th>
                <td>Verified co-op activity</td>
                <td>Hound13 developer discussion.</td>
              </tr>
              <tr>
                <th scope="row">Quick Entry</th>
                <td>Verified multiplayer function</td>
                <td>Official 1.0.7 update notes.</td>
              </tr>
              <tr>
                <th scope="row">Retry</th>
                <td>Party leader can restart a Hunt/Raid after a final clear or party wipe</td>
                <td>Official 1.0.11 update notes.</td>
              </tr>
              <tr>
                <th scope="row">Lobby matching</th>
                <td>Searches by fastest response time; the former search-range setting was removed</td>
                <td>Official 1.0.11 update notes.</td>
              </tr>
              <tr>
                <th scope="row">Version mismatch notices</th>
                <td>Shown for a higher version in Quick Entry and when an invite-code party leader uses a different version</td>
                <td>Official 1.0.11 update notes.</td>
              </tr>
              <tr>
                <th scope="row">Unresponsive party leader</th>
                <td>Lobby disbands the party after a long period</td>
                <td>Official 1.0.10 update notes; no exact timeout is stated.</td>
              </tr>
              <tr>
                <th scope="row">Exact player count</th>
                <td>Not yet verified</td>
                <td>No official or first-hand evidence in this project.</td>
              </tr>
              <tr>
                <th scope="row">Unlock requirement</th>
                <td>Not yet verified</td>
                <td>No official or first-hand evidence in this project.</td>
              </tr>
              <tr>
                <th scope="row">Complete invite or menu flow</th>
                <td>Not yet verified</td>
                <td>1.0.11 confirms invite-code version notices, but not a step-by-step join path.</td>
              </tr>
              <tr>
                <th scope="row">Crossplay</th>
                <td>Not yet verified</td>
                <td>No official or first-hand evidence in this project.</td>
              </tr>
              <tr>
                <th scope="row">Shared progression and loot rules</th>
                <td>Not yet verified</td>
                <td>No official or first-hand evidence in this project.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2>What Can You Play in Co-op?</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Activity</th>
                <th scope="col">Co-op?</th>
                <th scope="col">Notes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Story</th>
                <td>Not currently verified</td>
                <td>Hound13 said it was not ready for launch and discussed it as a possible post-launch feature.</td>
              </tr>
              <tr>
                <th scope="row">Open-world exploration</th>
                <td>Not currently verified</td>
                <td>No primary-source confirmation of current open-world co-op was found.</td>
              </tr>
              <tr>
                <th scope="row">Subjugation</th>
                <td>Yes</td>
                <td>Identified by Hound13 as a co-op activity.</td>
              </tr>
              <tr>
                <th scope="row">Raids</th>
                <td>Yes</td>
                <td>Identified by Hound13 as a co-op activity.</td>
              </tr>
              <tr>
                <th scope="row">Solo play</th>
                <td>Yes</td>
                <td>Steam lists the game as Single-player; co-op is not the whole game.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2>What We Still Need to Verify</h2>
        <p class="evidence-note"><strong>Not yet verified:</strong> exact player count, unlock level or quest, the complete invite-code/menu path, crossplay, cross-save, shared progression, shared world progression, loot ownership, loot sharing, story co-op, open-world co-op, region restrictions and broader host/guest rules. This page will not turn those unknowns into recommendations until official or first-hand evidence supports them.</p>

        <h2>Can You Play the Story in Co-op?</h2>
        <p><strong>Current story co-op has not yet been verified by our sources.</strong> Hound13 confirmed that story-mode co-op was not ready for launch and discussed it as a possible post-launch feature. That earlier statement does not establish whether it is available in the current build.</p>

        <h2>Does DragonSword: Awakening Have Open-World Co-op?</h2>
        <p><strong>There is no verified open-world co-op feature in the evidence reviewed for this page.</strong> We do not convert community reports into a current official feature specification.</p>
        <p class="community-note"><strong>Community signal / not fully verified:</strong> Steam discussions contain recurring questions about co-op scope and how the game compares with broader shared-world co-op. Those discussions indicate demand for a clear answer, but do not establish a current feature beyond the primary-source evidence above.</p>

        <AdsterraNativeBanner />

        <h2>Can You Play DragonSword: Awakening Solo?</h2>
        <p>Yes. Steam lists DragonSword: Awakening as a single-player game, and co-op is limited to selected activities. Multiplayer is not presented as a requirement for the main RPG.</p>

        <h2>How Do You Play With Friends?</h2>
        <p>Hound13 confirmed co-op for Subjugation and Raids. The 1.0.7 notes added Quick Entry, while 1.0.11 confirms that invite codes exist by documenting a version-mismatch notice when joining through one. The reviewed primary sources do not provide a complete menu sequence, so this page does not invent one.</p>

        <h2>Does DragonSword: Awakening Have Matchmaking?</h2>
        <p><strong>Multiplayer matching support is confirmed by the official update notes.</strong> Version 1.0.7 added Quick Entry and a lobby search-range setting. Version 1.0.11 removed that setting and now searches for lobbies by fastest response time. The same final notes add a higher-version notice during Quick Entry and a version-mismatch notice for invite-code joins.</p>

        <h2>Does DragonSword: Awakening Have PvP?</h2>
        <p>No PvP feature was verified in the primary sources reviewed for this page. The confirmed multiplayer discussion is about cooperative PvE activities.</p>

        <h2>DragonSword Awakening Multiplayer FAQ</h2>
        <details>
          <summary>Is DragonSword: Awakening an MMO?</summary>
          <p>No. It is primarily a single-player RPG with selected online co-op content.</p>
        </details>
        <details>
          <summary>Can I play DragonSword: Awakening with friends?</summary>
          <p>Yes, for the confirmed co-op activities: Subjugation and Raids. Story and open-world co-op are not confirmed as current features.</p>
        </details>
        <details>
          <summary>Is co-op required?</summary>
          <p>No. Steam lists the game as single-player, and co-op is limited to selected activities.</p>
        </details>
      </div>

      <SourceList sources={sources} />
      <RelatedGuides links={[{ label: 'Gameplay Systems', href: '/gameplay/' }, { label: 'Team-building Guide', href: '/teams/' }, { label: 'Beginner Guide', href: '/guides/beginner/' }, { label: 'Roadmap', href: '/roadmap/' }]} />
    </article>
  </div>
</BaseLayout>

<style>
  .page-wrap { padding: 1.25rem 0 2rem; }
  .article-header { margin-bottom: 1.25rem; }
  .eyebrow { color: var(--accent-light); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  h1, h2 { line-height: 1.2; letter-spacing: -0.025em; }
  h1 { font-size: clamp(2.4rem, 7vw, 5rem); margin: 0 0 0.75rem; max-width: 760px; }
  h2 { font-size: clamp(1.35rem, 4vw, 1.75rem); margin: 2.5rem 0 0.8rem; }
  p { margin: 0 0 1rem; }
  .article-body { max-width: 800px; }
  .article-body a { font-weight: 700; }
  .status-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.7rem; margin: 1rem 0 2rem; }
  .status-grid div { display: grid; gap: 0.3rem; padding: 1rem; border-top: 1px solid var(--accent); background: var(--paper); }
  .status-grid span { color: var(--muted); font-size: 0.76rem; }
  .community-note,
  .evidence-note { padding: 1rem; border-left: 2px solid var(--accent); background: var(--paper); color: var(--muted-strong); }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); background: var(--paper); margin: 1rem 0 1.5rem; }
  .mechanism-table { margin-top: 1.25rem; }
  table { width: 100%; min-width: 600px; border-collapse: collapse; font-size: 0.92rem; }
  th, td { border-bottom: 1px solid var(--line); padding: 0.8rem; text-align: left; vertical-align: top; }
  thead th { background: var(--raised); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  tbody th { width: 25%; font-weight: 700; }
  details { border-top: 1px solid var(--line); padding: 1rem 0; }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; font-weight: 700; min-height: 44px; padding-top: 0.4rem; }
  details p { margin: 0.65rem 0 0; color: var(--muted); }
  @media (max-width: 760px) { .status-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .status-grid { grid-template-columns: 1fr; } }
</style>
