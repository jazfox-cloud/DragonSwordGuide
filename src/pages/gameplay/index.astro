---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import LastVerified from '../../components/LastVerified.astro'; import GuideCard from '../../components/GuideCard.astro'; import SourceList from '../../components/SourceList.astro'; import RelatedGuides from '../../components/RelatedGuides.astro'; import AdsterraNativeBanner from '../../components/AdsterraNativeBanner.astro'; import { sourceUrls } from '../../data/sources';
const title='DragonSword Awakening Gameplay — Open World, Combat & Co-op'; const description='DragonSword Awakening gameplay overview covering open-world exploration, three-Hero tag combat, Status Ailments, Signal Skills, Familiars, Cooking, quests and multiplayer.'; const canonical='https://dragonswordguide.com/gameplay/'; const article={ '@context':'https://schema.org','@type':'Article',headline:title,description,mainEntityOfPage:canonical,datePublished:'2026-08-08',dateModified:'2026-08-08',publisher:{'@type':'Organization',name:'DragonSword Guide'} }; const sources=[{label:'Official Steam store page',href:sourceUrls.steam,note:'primary source for Orbis, exploration, companions, Familiars, Cooking, combat and 19 Heroes.'},{label:'Official YouTube channel',href:sourceUrls.youtube,note:'official video source for gameplay media; check the channel for current footage.'}];
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="article" schema={[article]}><div class="shell page-wrap"><Breadcrumbs items={[{label:'DragonSword Guide',href:'/'},{label:'Gameplay'}]}/><article><header class="article-header"><p class="eyebrow">Overview · What you actually do</p><h1>DragonSword Awakening Gameplay</h1><LastVerified date="August 8, 2026"/></header><div class="intro"><p>DragonSword: Awakening combines an anime-style open world on the Continent of Orbis with a three-Hero tag combat system. The game’s official description also calls out companions, Familiars, Cooking, quests, caves and dungeons.</p><a class="media-link" href={sourceUrls.youtube}>Watch official gameplay media on YouTube ↗</a></div><div class="card-grid"><GuideCard href="/guides/combat-system/" title="Tag combat" description="Active Skills, Status Ailments, Signal Skills and Switching Signals."/><GuideCard href="/map/" title="Open world" description="Meadows, cellars, deep seas, caves and dungeons across Orbis."/><GuideCard href="/multiplayer/" title="Online co-op" description="Selected co-op activities, Quick Entry and current matching evidence."/></div><div class="copy"><h2>Exploration and quests</h2><p>Orbis is designed to be explored on foot. The official store page names hidden caves, dungeons, secret cellars and deep-sea treasure, alongside local-resident problems and story quests.</p><h2>Familiars and Cooking</h2><p>Familiars travel with you and aid the journey. Cooking combines ingredients found across the continent, giving exploration a practical reason beyond scenery.</p><AdsterraNativeBanner /><h2>Multiplayer</h2><p>Steam lists Online Co-op, while developer and update notes narrow the confirmed current activities to selected co-op content. See the <a href="/multiplayer/">multiplayer guide</a> for the evidence boundary.</p></div><SourceList sources={sources}/><RelatedGuides links={[{ label: 'PC System Requirements', href: '/system-requirements/' }, { label: 'Beginner Guide', href: '/guides/beginner/' }, { label: 'Map', href: '/map/' }]}/></article></div></BaseLayout>
<style>.page-wrap{padding:1.25rem 0 2rem}.article-header{max-width:820px;margin-bottom:1.5rem}.eyebrow{color:var(--accent-light);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}h1,h2{line-height:1.1;letter-spacing:-.04em}h1{font-size:clamp(2.4rem,7vw,5rem);margin:0 0 .7rem}h2{font-size:clamp(1.45rem,3vw,2rem);margin:2.5rem 0 .7rem}.intro{display:grid;gap:1rem;max-width:800px}.intro p,.copy p{color:var(--muted-strong)}.media-link{width:fit-content;color:var(--accent-light);font-size:.86rem;font-weight:800;text-decoration:none}.card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem;margin:2.5rem 0}.copy{max-width:760px}@media(max-width:700px){.card-grid{grid-template-columns:1fr}}</style>
