---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LastVerified from '../../../components/LastVerified.astro';
import QuickAnswer from '../../../components/QuickAnswer.astro';
import SourceList from '../../../components/SourceList.astro';
import SourceRevisionMeta from '../../../components/SourceRevisionMeta.astro';
import InteractiveMap from '../../../components/InteractiveMap.astro';
import markerData from '../../../data/map-markers.json';
import chestManifest from '../../../../public/data/map/chests/manifest.json';
import { mapJaPage as page } from '../../../content/ja/map';
import { mapJa } from '../../../i18n/map/ja';
import { getArticleSchema, getBreadcrumbSchema, getCanonical } from '../../../i18n/seo';
import { sourceUrls, patch107 } from '../../../data/sources';

const canonical = getCanonical('map', 'ja');
const totalMapMarkers = markerData.markers.length + chestManifest.total_published;
const article = getArticleSchema('ja', { title: page.title, description: page.description, canonical, datePublished: '2026-08-08', dateModified: '2026-08-23' });
const breadcrumb = getBreadcrumbSchema('ja', [{ name: 'DragonSword Guide', path: '/ja/' }, { name: 'マップ', path: '/ja/map/' }]);
const sources = [
  { label: 'Steam公式ストア', href: sourceUrls.steam, note: 'Evidence B - オルビス、草原、監視塔の地下室、深い海、洞窟、ダンジョンの文脈を確認。' },
  { label: '公式1.0.7アップデート', href: patch107.href, note: 'Evidence B - World Map pin容量が100から200へ増えたことを確認。' },
  { label: 'GrandWiki Orbis map', href: 'https://dsawakening.grandwiki.com/map', note: 'Evidence C - ウェイポイント、宝箱、ダンジョン、フィールドボスなどの公開レイヤー確認。座標データはコピーしていません。' },
  { label: 'Public chest map layer', href: 'https://dragonswordawakening.net/map', note: 'Evidence C - 宝箱位置の複数ソース照合に利用。完全な座標データの複製ではありません。' },
];
---

<BaseLayout title={page.title} description={page.description} canonical={canonical} locale="ja" routeId="map" ogType="article" schema={[article, breadcrumb]}>
  <div class="shell page-wrap">
    <Breadcrumbs ariaLabel="パンくずリスト" items={[{ label: 'DragonSword Guide', href: '/ja/' }, { label: 'マップ' }]} />
    <article>
      <header class="article-header">
        <p class="eyebrow">マップ · インタラクティブ beta</p>
        <h1>{page.h1}</h1>
        <LastVerified date="2026年8月23日" label="最終確認" />
      </header>
      <QuickAnswer eyebrow="要点" title="このマップはオルビス探索の目安です。正確な公式ピンではありません。">
        <p>現在の日本語マップは、英語版と同じ共有データを使います。宝箱、ウェイポイント、ダンジョン、フィールドボス、Eona's Legacy、Organa Statueを検索できますが、座標はすべておおよその位置です。</p>
      </QuickAnswer>
      <InteractiveMap markerData={markerData} chestMarkerCount={chestManifest.total_published} locale="ja" labels={mapJa} />
      <section class="copy">
        <h2>現在掲載している内容</h2>
        <p>このbetaマップは、合計{totalMapMarkers}件のマーカーを掲載しています。内訳は、宝箱1,484件、ウェイポイント20件、ダンジョン26件、フィールドボス9件、Organa Statue 13件、Eona's Legacy 3件です。</p>
        <h2>検証ステータス</h2>
        <p>座標系は <strong>IMAGE_RELATIVE_COORDINATES</strong>、ベースは <strong>OWN_SCHEMATIC_ORBIS_BASE_MAP</strong> です。公式・動画・一次確認済みの正確なゲーム内ピンとしては扱いません。</p>
        <h2>日本語検索</h2>
        <p>検索は日本語ラベル、英語名、英語alias、日本語alias、地域名をまとめて確認します。例: <strong>宝箱</strong>、<strong>ウェイポイント</strong>、<strong>ダンジョン</strong>、<strong>フィールドボス</strong>、または英語の <strong>Warp Point</strong> でも検索できます。</p>
        <h2>データ方針</h2>
        <p>日本語版は座標ファイルを複製しません。1,484件の宝箱座標は既存の共有チャンクを読み込み、日本語名は安定IDと地域名から決定的に生成します。公式日本語名が未確認の固有名詞は、英語名を残します。</p>
      </section>
      <SourceList title="出典と検証" intro="このページは位置を確定情報としてではなく、複数公開ソースで照合したおおよその探索目安として表示します。" sources={sources} />
    </article>
  </div>
  <SourceRevisionMeta metadata={page.translation} />
</BaseLayout>

<style>
  .page-wrap { padding: 1.25rem 0 2rem; }
  .article-header, .copy { max-width: 860px; }
  .eyebrow { color: var(--accent-light); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1, h2 { line-height: 1.15; letter-spacing: 0; }
  h1 { font-size: clamp(2.2rem, 7vw, 4.7rem); margin: 0 0 0.7rem; }
  h2 { margin: 2.2rem 0 0.7rem; }
  .copy p { color: var(--muted-strong); }
  .copy strong { overflow-wrap: anywhere; }
</style>
