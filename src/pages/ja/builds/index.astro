---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LastVerified from '../../../components/LastVerified.astro';
import QuickAnswer from '../../../components/QuickAnswer.astro';
import SourceList from '../../../components/SourceList.astro';
import SourceRevisionMeta from '../../../components/SourceRevisionMeta.astro';
import { buildsJa as page } from '../../../content/ja/builds';
import { sourceUrls } from '../../../data/sources';
import { getArticleSchema, getBreadcrumbSchema, getCanonical } from '../../../i18n/seo';

const canonical = getCanonical('builds', 'ja');
const article = getArticleSchema('ja', { title: page.title, description: page.description, canonical, datePublished: '2026-08-08', dateModified: '2026-10-19' });
const breadcrumb = getBreadcrumbSchema('ja', [{ name: 'DragonSword Guide', path: '/ja/' }, { name: 'ビルド', path: '/ja/builds/' }]);
const sources = [{ label: 'Steam公式ストア', href: sourceUrls.steam, note: '2026年10月19日確認。アクティブスキルによる状態異常とシグナルスキルの連携を説明しています。個別ビルドや本ページの比較手順の有効性を証明する資料ではありません。' }];
---

<BaseLayout title={page.title} description={page.description} canonical={canonical} locale="ja" routeId="builds" ogType="article" schema={[article, breadcrumb]}>
  <div class="shell page-wrap">
    <Breadcrumbs ariaLabel="パンくずリスト" items={[{ label: 'DragonSword Guide', href: '/ja/' }, { label: 'ビルド' }]} />
    <article class="copy">
      <header class="article-header"><p class="eyebrow">ビルド計画 · 自分の構成を比較する</p><h1>{page.h1}</h1><LastVerified date="2026年10月19日" label="記事更新" /></header>
      <QuickAnswer eyebrow="要点" title="同じ戦闘で、変更を1つだけ比較します。">
        <p>現在の構成と解決したい問題を書き出します。1つだけ変更して同じ戦闘を繰り返し、狙った連携、生存、クリアの安定性を比較してください。これは計画用チェックリストです。実測済みのキャラクタービルドや最強ランキングではありません。</p>
      </QuickAnswer>
      <h2>1. 変更する前に、解決したい問題を選ぶ</h2>
      <ul>
        <li><strong>シグナルが出ない:</strong> 受け手のスキルに書かれた条件と、その条件を作る手順を確認します。装備を変更する前に、<a href="/guides/combat-system/">シグナルスキルガイド（英語）</a>で連携を確認してください。</li>
        <li><strong>戦闘をクリアできない:</strong> どこで失敗し、どの動きまで安定して再現できるかを記録します。まずクリアできるかを比較します。</li>
        <li><strong>クリアを速くしたい:</strong> 戦闘、難易度、開始条件をそろえてから所要時間を比べます。</li>
      </ul>
      <h2>2. 基準を記録し、1つだけ変更する</h2>
      <p>公式の戦闘紹介は、アクティブスキル、状態異常、シグナルスキルのつながりを説明しています。自分の構成では、使用中のバージョンのスキル説明を記録してください。すべての英雄が同じ追撃を起動できるとは限りません。</p>
      <ol>
        <li><strong>構成Aを記録:</strong> ゲームのバージョン、戦闘と難易度、英雄、装備、ルーン、実際に使うスキルと交代の順番を書きます。</li>
        <li><strong>構成Bを選ぶ:</strong> 使用可能なルーンや交代順など、1つだけ変更します。他の記録項目も変えると、どの変更が効いたかを切り分けられません。</li>
        <li><strong>同じ条件で繰り返す:</strong> 各回の成功・失敗と、選んだ比較項目を記録します。中断や敵の条件が変わった回は分けて扱います。</li>
        <li><strong>次の行動を決める:</strong> 選んだ目的で改善を繰り返し確認できた場合にBを採用します。結果が混在する場合は、強い構成と断定せず「判断保留」にします。</li>
      </ol>
      <h2>3. この比較メモを自分のノートにコピーする</h2>
      <ul>
        <li>バージョン / 戦闘 / 難易度:</li>
        <li>解決したい問題:</li>
        <li>構成A — 英雄 / 装備 / ルーン / 行動順:</li>
        <li>構成B — 変更した1項目:</li>
        <li>Aの各試行 — クリア / シグナル連携 / 所要時間のうち必要な項目:</li>
        <li>Bの各試行 — Aと同じ観察項目:</li>
        <li>条件の変化や中断:</li>
        <li>判断 — Aを維持 / Bを採用 / 判断保留、その理由:</li>
      </ul>
      <p>例えば、ルーンと交代順を同時に変えて次の戦闘に成功しても、ルーンが原因とは証明できません。成功した試行として記録し、その仮定に追加のリソースを使う前に、変更を1つに絞って再比較します。</p>
      <h2>この比較で判断できる範囲</h2>
      <p>記録は、試したバージョン、戦闘、構成での選択に役立ちます。万能のスキル優先度、最強ルーンセット、Karmaの投資順、DPSランキングを示すものではありません。更新で関連スキルが変わった場合は、その説明を再確認してください。</p>
      <p>次に確認したい内容に合わせて、<a href="/guides/combat-system/">シグナルと表示されない原因（英語）</a>、<a href="/ja/systems/runes/">確認済みのルーン仕様変更</a>、<a href="/teams/">チーム編成の概要（英語）</a>へ進めます。</p>
      <SourceList title="出典と確認範囲" intro="公式資料は戦闘の概要を裏付けます。比較チェックリストは編集上の提案であり、実測済みのビルドや公式の最適化式ではありません。" sources={sources} />
    </article>
  </div>
  <SourceRevisionMeta metadata={page.translation} />
</BaseLayout>

<style>
  .page-wrap { padding: 1.25rem 0 2rem; }
  .copy { max-width: 800px; }
  .eyebrow { color: var(--accent-light); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1, h2 { line-height: 1.15; letter-spacing: 0; }
  h1 { font-size: clamp(2.3rem, 7vw, 4.8rem); margin: 0 0 0.7rem; }
  h2 { margin: 2.2rem 0 0.7rem; }
  p, li { color: var(--muted-strong); }
  li { margin: 0.4rem 0; }
  .evidence-note { padding: 1rem; border-left: 3px solid var(--accent); background: var(--paper); }
</style>
