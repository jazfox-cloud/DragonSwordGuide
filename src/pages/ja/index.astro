---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceRevisionMeta from '../../components/SourceRevisionMeta.astro';
import { homeJa as page } from '../../content/ja/home';
import { getCanonical, absoluteUrl } from '../../i18n/seo';

const canonical = getCanonical('home', 'ja');
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  inLanguage: 'ja',
  name: 'DragonSword Guide',
  url: canonical,
  description: page.description,
};
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DragonSword Guide',
  url: absoluteUrl('/ja/'),
  description: 'DragonSword: Awakening の非公式ファンガイド。',
};
---

<BaseLayout title={page.title} description={page.description} canonical={canonical} locale="ja" routeId="home" schema={[website, organization]}>
  <div class="ja-page home">
    <section class="hero shell">
      <p class="eyebrow">DragonSword : Awakening · 非公式ファンガイド</p>
      <h1>{page.h1}</h1>
      <p class="lede">アニメ調オープンワールドのオルビスを進めるための、出典重視の攻略ハブです。ロードマップ、マップ、ルーン、マルチプレイ、ビルドを、確認済みの事実と未検証の内容に分けて読めます。</p>
      <div class="hero-actions">
        <a class="button primary" href="/ja/map/">マップを開く</a>
        <a class="button secondary" href="/ja/roadmap/">ロードマップを見る</a>
        <a class="text-link" href="/ja/multiplayer/">マルチプレイ確認状況</a>
      </div>
      <div class="stats" aria-label="確認済みの基礎情報">
        <span><strong>19</strong>英雄</span>
        <span><strong>1,555</strong>map markers</span>
        <span><strong>500</strong>ルーン所持上限</span>
        <span><strong>Online</strong>協力プレイ</span>
      </div>
    </section>

    <section class="shell section">
      <h2>目的別に読む</h2>
      <div class="card-grid">
        <a class="card" href="/ja/roadmap/"><span>アップデート</span><h3>ロードマップ</h3><p>リリース済み、発表済み、未確定の内容を分けて確認します。</p></a>
        <a class="card" href="/ja/map/"><span>オルビス</span><h3>インタラクティブマップ</h3><p>宝箱、ウェイポイント、ダンジョン、フィールドボスを検索できます。位置はおおよその目安です。</p></a>
        <a class="card" href="/ja/systems/runes/"><span>システム</span><h3>ルーン</h3><p>所持上限500、4星ルーン合成、未検証のドロップ率を分けて整理します。</p></a>
        <a class="card" href="/ja/multiplayer/"><span>協力プレイ</span><h3>マルチプレイ</h3><p>オンライン協力プレイ、Quick Entry、Raids、未確認の範囲を確認します。</p></a>
        <a class="card" href="/ja/builds/"><span>育成</span><h3>ビルド</h3><p>英雄の役割、状態異常、シグナルスキル、ルーン、チーム編成を考えます。</p></a>
      </div>
    </section>

    <section class="shell section trust">
      <h2>この日本語版の方針</h2>
      <div class="trust-grid">
        <div><strong>公式用語を優先</strong><p>ゲーム名、オルビス、オンライン協力プレイなどは公式日本語表記を使います。</p></div>
        <div><strong>未確認は未確認のまま</strong><p>正確な場所、確率、最強ビルド、未発表日程は推測で補いません。</p></div>
        <div><strong>英語名を残す場合があります</strong><p>Eona's Legacy や Organa Statue など、公式日本語名が未確認の固有名詞は英語名を保持します。</p></div>
      </div>
    </section>
  </div>
  <SourceRevisionMeta metadata={page.translation} />
</BaseLayout>

<style>
  .ja-page { overflow: hidden; }
  .hero { padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 6vw, 4rem); }
  .eyebrow { color: var(--accent-light); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1 { max-width: 13ch; margin: 0; font-size: clamp(2.7rem, 8vw, 5.8rem); line-height: 1.04; letter-spacing: 0; }
  h2 { margin: 0 0 1rem; font-size: clamp(1.5rem, 4vw, 2.2rem); line-height: 1.15; letter-spacing: 0; }
  .lede { max-width: 70ch; color: var(--muted-strong); font-size: 1.05rem; }
  .hero-actions, .stats { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.4rem; }
  .button { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; border-radius: 8px; padding: 0.7rem 1rem; font-size: 0.85rem; font-weight: 800; text-decoration: none; }
  .primary { color: var(--wash); background: var(--accent); }
  .secondary { color: var(--ink); border: 1px solid var(--line); background: var(--paper); }
  .text-link { display: inline-flex; min-height: 44px; align-items: center; color: var(--accent-light); font-size: 0.85rem; font-weight: 800; text-decoration: none; }
  .stats span { display: grid; min-width: 130px; padding: 0.75rem; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--muted); font-size: 0.8rem; }
  .stats strong { color: var(--ink); font-size: 1.25rem; }
  .section { margin-top: clamp(3rem, 7vw, 5rem); }
  .card-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.75rem; }
  .card { display: grid; min-height: 190px; align-content: start; gap: 0.45rem; padding: 1.1rem; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--ink); text-decoration: none; }
  .card:hover { border-color: var(--accent); background: var(--raised); }
  .card span { color: var(--accent-light); font-size: 0.7rem; font-weight: 800; }
  .card h3 { margin: 0; font-size: 1.02rem; }
  .card p, .trust p { margin: 0; color: var(--muted); font-size: 0.86rem; }
  .trust-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .trust-grid div { border-top: 1px solid var(--accent); padding-top: 0.8rem; }
  @media (max-width: 980px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .card-grid, .trust-grid { grid-template-columns: 1fr; } }
</style>
