---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LastVerified from '../../../components/LastVerified.astro';
import QuickAnswer from '../../../components/QuickAnswer.astro';
import SourceList from '../../../components/SourceList.astro';
import SourceRevisionMeta from '../../../components/SourceRevisionMeta.astro';
import { roadmapJa as page } from '../../../content/ja/roadmap';
import { sourceUrls, patch107, patch109, patch110, latestAppliedPatch, previousApplied, patch111Preview } from '../../../data/sources';
import { getArticleSchema, getBreadcrumbSchema, getCanonical } from '../../../i18n/seo';

const canonical = getCanonical('roadmap', 'ja');
const article = getArticleSchema('ja', { title: page.title, description: page.description, canonical, datePublished: '2026-08-08', dateModified: '2026-09-13' });
const breadcrumb = getBreadcrumbSchema('ja', [{ name: 'DragonSword Guide', path: '/ja/' }, { name: 'ロードマップ', path: '/ja/roadmap/' }]);
const sources = [
  { label: '公式ロードマップ & Q&A', href: sourceUrls.roadmap, note: 'Evidence B - 今後の予定、英雄、Rifts、マルチプレイRaids、プラットフォーム状況の一次情報。' },
  { label: '公式1.0.12アップデート', href: latestAppliedPatch.href, note: 'Evidence B - 2026年9月10日 KST公開の適用済み最新パッチ。' },
  { label: '公式1.0.11アップデート', href: previousApplied.href, note: 'Evidence B - 2026年9月3日 KSTに適用された直前の公式パッチ。' },
  { label: '公式1.0.10アップデート', href: patch110.href, note: 'Evidence B - 2026年8月19日に適用された過去の公式パッチ。' },
  { label: '公式1.0.11パッチプレビュー（履歴）', href: patch111Preview.href, note: 'Evidence B - 予告の出典として保存。別枠のComing Nextは1.0.11適用済み内容に含めません。' },
];
---

<BaseLayout title={page.title} description={page.description} canonical={canonical} locale="ja" routeId="roadmap" ogType="article" schema={[article, breadcrumb]}>
  <div class="shell page-wrap">
    <Breadcrumbs ariaLabel="パンくずリスト" items={[{ label: 'DragonSword Guide', href: '/ja/' }, { label: 'ロードマップ' }]} />
    <article>
      <header class="article-header">
        <p class="eyebrow">アップデート · 出典タイムライン</p>
        <h1>{page.h1}</h1>
        <LastVerified date="2026年9月13日" label="最終確認" />
      </header>
      <QuickAnswer eyebrow="要点" title="最新確認状況: 1.0.12は適用済みの最新アップデートです。">
        <p>2026年9月10日 KST公開の公式アップデートノートは、1.0.12が適用済みであることを明記しています。Ryza、Othello Hero Quest、Hunt Hell Modeは日程未定のComing Nextのままです。</p>
      </QuickAnswer>
      <div class="timeline">
        <div><span>最新適用済み / リリース済み</span><h2>1.0.12 適用済み</h2><p>2026年9月10日 KST公開の公式アップデートノートで適用が確認されています。</p></div>
        <div><span>適用済み / 過去の更新</span><h2>1.0.11 適用済み</h2><p><a href={previousApplied.href}>1.0.11は直前の適用済みパッチ</a>で、<a href={patch109.href}>1.0.9はさらに過去の履歴</a>です。</p></div>
        <div><span>今後の予定 / 日程未定</span><h2>Coming Next</h2><p>Ryza、Othello Hero Quest、Hunt Hell Modeは別枠で予告されており、確定した配信日は示されていません。</p></div>
      </div>
      <section class="copy">
        <h2>最新適用済み / リリース済み: 1.0.12</h2>
        <p>公式の適用済みノートには、次の修正が記載されています。</p>
        <ul><li>AriaのBomb Arrowsの攻撃回数説明と、Theresiaのコスチュームの武器説明を修正。</li><li>AstriaがBlazing Lightningを習得した際にSlideへ意図しないクールダウンが発生する問題と、Slide中に向きを変えられない問題を修正。</li><li>Andras the Cave Predatorの天井ぶら下がりパターン中の異常なSuper Armor、被弾によるFamiliarからの降下と切り替えが重なった際の無敵化、5-Star Equipmentの製作演出を最後まで再生すると結果ポップアップを閉じられない問題を修正。</li></ul>
        <h2>適用済み / 過去の更新: 1.0.11</h2>
        <p>最終アップデートノートで、次の適用内容が確認できます。</p>
        <ul><li>1秒間の無敵、3秒間の確定クリティカル、Active Skill Rageゲージ10%回復、Dodge Stamina消費の半分回復を伴うJust Dodge。</li><li>Lock-Onの操作、ターゲット保持、検索、カメラの改善。</li><li>切り替え後にフィールドに残る英雄のSuper Armorが1秒間破壊されない調整。</li><li>Lute、Aria、Tarte、Roxy、Astria、Kalsion、Danaのバランス調整。</li><li>マルチプレイのRetry、応答が最も速いロビーの検索、バージョン通知、ロビー不具合の修正。</li><li>システムのQoL改善、ローカライズ修正、記載された不具合修正。</li></ul>
        <p class="evidence-note"><strong>最終ノートの境界:</strong> これらの適用済み情報は、予告ではなく最終版の1.0.11アップデートノートを根拠とします。</p>
        <h2>適用済み / 過去の更新: 1.0.10</h2>
        <ul><li>1.0.10は2026年8月19日に適用された過去の公式パッチです。</li><li><a href={patch107.href}>1.0.7</a>はQuick Entry、旧マッチング範囲設定、マップピン、ルーン変更の履歴として参照します。</li></ul>
        <h2>Coming Next / 日程未定</h2>
        <p>8月28日のプレビューは、次の項目を「Coming Next」として別枠で紹介しています。最終版の1.0.11と1.0.12のアップデートノートには含まれていないため、適用済みとはせず予告のまま扱います。</p>
        <ul><li>プレイアブル英雄 Ryza。</li><li>Othello Hero Quest。</li><li>Hunt Hell Mode。</li></ul>
        <h2>今後 / 日程未定</h2>
        <ul><li>以前の公式ロードマップでは、Jerome、Veronica、Loganの追加英雄や、Hero Quest、Rift、マルチプレイRaidの方向性も示されていますが、確定した配信日はありません。</li><li>コンソール版、クロスプラットフォーム、ストーリー協力、オープンワールド協力は、このページでは確定情報として扱いません。</li></ul>
        <p class="evidence-note"><strong>Evidence B の境界:</strong> 公式ロードマップとSteam公式お知らせを一次情報として扱います。コミュニティ情報は疑問の発見には使えますが、機能・日程・対応プラットフォームを確定させる根拠にはしません。</p>
        <p>現在のシステム変更は <a href="/ja/systems/runes/">ルーン</a> と <a href="/ja/builds/">ビルド</a> のページでも確認できます。</p>
      </section>
      <SourceList title="出典と検証" intro="Evidence Bは一次情報、Evidence Cはコミュニティ確認として扱います。" sources={sources} />
    </article>
  </div>
  <SourceRevisionMeta metadata={page.translation} />
</BaseLayout>

<style>
  .page-wrap { padding: 1.25rem 0 2rem; }
  .article-header, .copy { max-width: 820px; }
  .eyebrow { color: var(--accent-light); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  h1, h2 { line-height: 1.15; letter-spacing: 0; }
  h1 { font-size: clamp(2.3rem, 7vw, 4.8rem); margin: 0 0 0.7rem; }
  h2 { margin: 2.2rem 0 0.7rem; }
  .timeline { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 2rem 0; }
  .timeline div { border-top: 1px solid var(--accent); padding-top: 1rem; }
  .timeline span { color: var(--accent-light); font-size: 0.72rem; font-weight: 800; }
  .timeline p, .copy p, .copy li { color: var(--muted-strong); }
  .evidence-note { padding: 1rem; border-left: 3px solid var(--accent); background: var(--paper); }
  @media (max-width: 760px) { .timeline { grid-template-columns: 1fr; } }
</style>
