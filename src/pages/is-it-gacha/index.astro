import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import LastVerified from '../../components/LastVerified.astro'; import QuickAnswer from '../../components/QuickAnswer.astro'; import SourceList from '../../components/SourceList.astro'; import { sourceUrls } from '../../data/sources';
const title='Is DragonSword Awakening a Gacha? Premium Price & Character Acquisition'; const description='Is DragonSword Awakening a gacha? Here is what official developer information and the Steam store say about the premium release, playable Heroes, DLC and randomized pulls.'; const canonical='https://dragonswordguide.com/is-it-gacha/'; const article={ '@context':'https://schema.org','@type':'Article',headline:title,description,mainEntityOfPage:canonical,datePublished:'2026-08-08',dateModified:'2026-08-08',publisher:{'@type':'Organization',name:'DragonSword Guide'} }; const sources=[{label:'Official Steam developer announcement',href:'https://store.steampowered.com/news/posts/?enddate=1780994574&feed=steam_community_announcements',note:'states the game is a premium single-purchase title, with gacha elements removed and playable heroes/core content obtainable through gameplay.'},{label:'Official Steam store page',href:sourceUrls.steam,note:'lists the $29.99 base price and optional DLC categories.'}];
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="article" schema={[article]}><div class="shell page-wrap"><Breadcrumbs items={[{label:'DragonSword Guide',href:'/'},{label:'Is It Gacha?'}]}/><article><header class="article-header"><p class="eyebrow">Exact answer · Monetization</p><h1>Is DragonSword Awakening a Gacha?</h1><LastVerified date="August 8, 2026"/></header><QuickAnswer title="No randomized character gacha is described in the official launch information."><p>Hound13 described DragonSword: Awakening as a premium single-purchase title, said in-game gacha elements were removed, and stated that playable Heroes and core content are obtainable through gameplay. Steam separately lists optional DLC such as costumes and Familiars.</p></QuickAnswer><div class="copy"><h2>What is the current model?</h2><p>The Steam store lists a $29.99 base price in the current page snapshot. Additional content appears as optional DLC categories, not as a randomized character-pull system in the official information reviewed here.</p><h2>How are characters acquired?</h2><p>The official announcement says playable Heroes and core content are obtainable through gameplay. We are not publishing exact unlock routes until each route is verified in the current retail build.</p><h2>What about DLC?</h2><p>Steam lists costume and Familiar DLC. Optional DLC is different from a randomized character gacha; prices and availability can change, so check the live store page before buying.</p></div><SourceList sources={sources}/></article></div></BaseLayout>
<style>.page-wrap{padding:1.25rem 0 2rem}.article-header{max-width:820px;margin-bottom:1.5rem}.eyebrow{color:var(--accent-light);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}h1,h2{line-height:1.1;letter-spacing:-.04em}h1{font-size:clamp(2.4rem,7vw,5rem);margin:0 0 .7rem}h2{font-size:clamp(1.45rem,3vw,2rem);margin:2.5rem 0 .7rem}.copy{max-width:760px}.copy p{color:var(--muted-strong)}</style>
