---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import LastVerified from '../../components/LastVerified.astro'; import VerificationBadge from '../../components/VerificationBadge.astro'; import SourceList from '../../components/SourceList.astro'; import { reportedRoster } from '../../data/characters'; import { sourceUrls } from '../../data/sources';
const title='All DragonSword Awakening Characters — 19-Hero Directory'; const description='A cautious DragonSword Awakening characters directory covering the confirmed 19-Hero roster, team switching, acquisition context, and verification status.'; const canonical='https://dragonswordguide.com/characters/'; const article={ '@context':'https://schema.org','@type':'Article',headline:title,description,mainEntityOfPage:canonical,datePublished:'2026-08-08',dateModified:'2026-08-10',publisher:{'@type':'Organization',name:'DragonSword Guide'} }; const sources=[{label:'Official Steam store page',href:sourceUrls.steam,note:'confirms 19 launch Heroes, companions and tag-team combat.'},{label:'Official Steam announcements',href:sourceUrls.announcements,note:'Evidence B — current update and character mentions.'},{label:'Official post-launch roadmap & Q&A',href:sourceUrls.roadmap,note:'Evidence B — names four additional Heroes planned for the second half of 2026; no release date is confirmed.'}];
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="article" schema={[article]}><div class="shell page-wrap"><Breadcrumbs items={[{label:'DragonSword Guide',href:'/'},{label:'Characters'}]}/><article><header class="article-header"><p class="eyebrow">Directory · Verification visible</p><h1>All DragonSword Awakening Characters</h1><LastVerified date="August 10, 2026"/></header><div class="answer"><strong>Quick answer:</strong> The official Steam description confirms 19 launch Heroes. The names below are a working directory; exact traits, factions, unlock routes and Status effects are not published here unless independently verified.</div><section class="intro"><h2>How team switching works</h2><p>DragonSword: Awakening describes a three-Hero tag-team built around Status Ailments, Signal Skills and Switching Signals. That gives the roster a shared combat language, but it does not make every role or pairing interchangeable.</p><h2>How acquisition works</h2><p>Launch acquisition details are still being verified at the page level. We will add exact unlock routes only from official or first-hand evidence rather than copying a research-only roster table.</p><h2>Post-launch Heroes in the official roadmap</h2><p>The official Post-Launch Roadmap names four additional Heroes planned for the second half of 2026: Ryza, Jerome, Veronica and Logan. Their planned inclusion does not make them part of the current 19-Hero launch roster, and no release date is confirmed.</p></section><section class="roster"><div class="roster-heading"><h2>Roster names</h2><VerificationBadge label="19 names tracked"/></div><div class="name-grid">{reportedRoster.map((name)=><div class="name-item"><strong>{name}</strong><span>Roster name · details not yet verified</span></div>)}</div></section><p class="note">Verification status: Verified means an official source mentions the identity or event; Partially Verified means the name is tracked but combat data is incomplete; Not Yet Verified means we need first-hand or primary confirmation.</p><SourceList sources={sources}/></article></div></BaseLayout>
<style>.page-wrap{padding:1.25rem 0 2rem}.article-header{max-width:820px;margin-bottom:1.5rem}.eyebrow{color:var(--accent-light);font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}h1,h2{line-height:1.1;letter-spacing:-.04em}h1{font-size:clamp(2.4rem,7vw,5rem);margin:0 0 .7rem}h2{font-size:clamp(1.45rem,3vw,2rem);margin:2.5rem 0 .7rem}.answer{max-width:780px;padding:1rem 1.15rem;border:1px solid hsl(199 86% 58% / .35);border-radius:12px;background:var(--accent-soft)}.answer strong{color:var(--accent-light)}.intro{max-width:760px}.intro p,.note{color:var(--muted-strong)}.roster{margin-top:2.5rem}.roster-heading{display:flex;align-items:center;gap:1rem}.roster-heading h2{margin:0}.name-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;margin-top:1rem}.name-item{display:grid;gap:.2rem;padding:.85rem;background:var(--paper);border:1px solid var(--line);border-radius:10px}.name-item span{color:var(--muted);font-size:.72rem;line-height:1.35}.note{margin-top:1.5rem;font-size:.88rem}@media(max-width:700px){.name-grid{grid-template-columns:repeat(2,1fr)}}</style>
