---
interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: Record<string, unknown>[];
}

const { title, description, canonical, schema = [] } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <span class="brand">DragonSword Guide</span>
        <span class="brand-note">Unofficial fan-made guides</span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        <p>DragonSword Guide is an unofficial fan site and is not affiliated with Hound13.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #17202b;
    --muted: #647180;
    --line: #dfe5ea;
    --paper: #ffffff;
    --wash: #f5f7f9;
    --accent: #7a3f25;
    --accent-soft: #fff5ed;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }
  body { margin: 0; color: var(--ink); background: var(--wash); line-height: 1.65; }
  a { color: var(--accent); }
  .shell { width: min(100% - 2rem, 920px); margin-inline: auto; }
  .site-header { background: var(--paper); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 1rem 0; }
  .brand { color: var(--ink); font-size: 1.05rem; font-weight: 750; text-decoration: none; letter-spacing: -0.02em; }
  .brand-note { color: var(--muted); font-size: 0.8rem; }
  .site-footer { color: var(--muted); font-size: 0.82rem; padding: 2.5rem 0; }
  .site-footer p { margin: 0; }
  @media (max-width: 560px) { .brand-note { display: none; } }
</style>
